<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <section class="bg-white py-5">
    <div class="container">
      <%- include("../includes/breadcrumbs") %>

      <div class="row g-5">
        <div class="col-lg-8">
          <% if (data.partner.slika && data.partner.slika.url) { %>
            <img src="<%= data.partner.slika.url %>" class="img-fluid rounded mb-4" alt="<%= data.partner.slika.alt || data.partner.naziv %>">
          <% } %>

          <h1 class="h3 mb-3"><%= data.partner.naziv %></h1>
          <p class="lead text-muted"><%= data.partner.kratakOpis %></p>

          <%- include("../includes/components/content-blocks-render", { blocks: data.partner.sadrzaj }) %>
        </div>

        <div class="col-lg-4">
          <div class="card shadow-sm">
            <div class="card-body">
              <a href="<%= data.partner.outboundUrl %>" target="_blank" rel="noopener sponsored" class="btn btn-primary w-100 mb-3">
                <%= data.partner.ctaLabel %> <i class="bi bi-box-arrow-up-right"></i>
              </a>

              <% if (data.partner.adresa) { %>
                <p class="small text-muted mb-2"><i class="bi bi-geo-alt"></i> <%= data.partner.adresa %></p>
              <% } %>

              <% if (data.partner.imaMapu) { %>
                <iframe
                  src="https://www.google.com/maps?q=<%= data.partner.geo.latitude %>,<%= data.partner.geo.longitude %>&output=embed"
                  width="100%" height="220" style="border:0; border-radius:8px;" loading="lazy"
                  title="Lokacija - <%= data.partner.naziv %>">
                </iframe>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include("../includes/footer") %>
