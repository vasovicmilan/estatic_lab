<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/moj-nalog" }) %>

<main class="container py-4">
  <%- include("../includes/flash-messages") %>
  <h1 class="h3 mb-4">Moji termini</h1>

  <%- include("../includes/components/employee-tabs") %>

  <form method="GET" class="mb-4" style="max-width: 250px;">
    <% if (data.paginationUpcoming.limit) { %><input type="hidden" name="limit" value="<%= data.paginationUpcoming.limit %>"><% } %>
    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
      <% data.filters.forEach(function(f) { %>
        <option value="<%= f.value %>" <%= data.selectedStatus === f.value ? 'selected' : '' %>><%= f.label %></option>
      <% }) %>
    </select>
  </form>

  <% if (data.appointments && data.appointments.length > 0) { %>
    <%
      // "Danas"/"Predstojeći" share one query+pager ("upcoming"), "Prošli" has its own ("past") -
      // same split as the customer's own list; see employee.controller.js's appointments().
      const upcomingSections = [
        { label: "Danas", items: data.groups.danas },
        { label: "Predstojeći", items: data.groups.predstojeci },
      ].filter((s) => s.items.length > 0);
      const pastItems = data.groups.prosli;
    %>

    <% upcomingSections.forEach(function(section) { %>
      <h2 class="h6 text-muted text-uppercase mt-4 mb-2"><%= section.label %></h2>
      <div class="list-group mb-3">
        <% section.items.forEach(function(a) { %>
          <a href="/moj-nalog/termini/detalji/<%= a.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold"><%= a.klijent %></div>
              <div class="text-muted small mono"><%= a.usluga %> &middot; <%= a.datum %></div>
            </div>
            <div class="text-end">
              <span class="badge bg-secondary"><%= a.status %></span>
              <div class="small price-mono"><%= a.cena %></div>
            </div>
          </a>
        <% }) %>
      </div>
    <% }) %>
    <% if (upcomingSections.length > 0) { %>
      <%- include("../includes/pagination", { pagination: data.paginationUpcoming }) %>
    <% } %>

    <% if (pastItems.length > 0) { %>
      <h2 class="h6 text-muted text-uppercase mt-4 mb-2">Prošli</h2>
      <div class="list-group mb-3">
        <% pastItems.forEach(function(a) { %>
          <a href="/moj-nalog/termini/detalji/<%= a.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <div>
              <div class="fw-semibold"><%= a.klijent %></div>
              <div class="text-muted small mono"><%= a.usluga %> &middot; <%= a.datum %></div>
            </div>
            <div class="text-end">
              <span class="badge bg-secondary"><%= a.status %></span>
              <div class="small price-mono"><%= a.cena %></div>
            </div>
          </a>
        <% }) %>
      </div>
      <%- include("../includes/pagination", { pagination: data.paginationPast }) %>
    <% } %>
  <% } else { %>
    <p class="text-muted">Nemate termina.</p>
  <% } %>
  <%- include("../includes/components/employee-external-busy", { externalBusy: data.externalBusy }) %>
</main>

<%- include("../includes/portal-footer") %>