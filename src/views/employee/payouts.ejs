<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/moj-nalog" }) %>

<main class="container py-4">
  <h1 class="h3 mb-4">Moje isplate</h1>
  <%- include("../includes/components/employee-tabs") %>

  <form method="GET" action="/moj-nalog/isplate" class="d-flex gap-2 mb-3">
    <select name="status" class="form-select form-select-sm" style="max-width:200px;" onchange="this.form.submit()">
      <% data.filters.status.options.forEach(function(opt) { %>
        <option value="<%= opt.value %>" <%= opt.value === data.filters.status.value ? "selected" : "" %>><%= opt.label %></option>
      <% }) %>
    </select>
  </form>

  <% if (data.items.length === 0) { %>
    <p class="text-muted">Nemate podnetih zahteva za isplatu.</p>
  <% } else { %>
    <div class="list-group d-lg-none">
      <% data.items.forEach(function(p) { %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-start">
            <div class="fs-5 fw-bold text-primary"><%= p.iznos %></div>
            <span class="badge bg-secondary"><%= p.status %></span>
          </div>
          <div class="text-muted small">Zatraženo: <%= p.zatrazeno %> &middot; Ažurirano: <%= p.azurirano %></div>
          <% if (p.napomena) { %><div class="small mt-1"><%= p.napomena %></div><% } %>
        </div>
      <% }) %>
    </div>

    <div class="card d-none d-lg-block">
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Iznos</th><th>Status</th><th>Zatraženo</th><th>Ažurirano</th><th>Napomena</th></tr></thead>
          <tbody>
            <% data.items.forEach(function(p) { %>
              <tr>
                <td><%= p.iznos %></td>
                <td><%= p.status %></td>
                <td><%= p.zatrazeno %></td>
                <td><%= p.azurirano %></td>
                <td><%= p.napomena || "-" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <%- include("../includes/pagination", { pagination: data.pagination }) %>
</main>

<%- include("../includes/portal-footer") %>