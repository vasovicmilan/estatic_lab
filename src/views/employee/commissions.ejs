<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/moj-nalog" }) %>

<main class="container py-4">
  <h1 class="h3 mb-4">Moja provizija</h1>
  <%- include("../includes/components/employee-tabs") %>

  <form method="GET" action="/moj-nalog/provizije" class="d-flex gap-2 mb-3">
    <select name="status" class="form-select form-select-sm" style="max-width:200px;" onchange="this.form.submit()">
      <% data.filters.status.options.forEach(function(opt) { %>
        <option value="<%= opt.value %>" <%= opt.value === data.filters.status.value ? "selected" : "" %>><%= opt.label %></option>
      <% }) %>
    </select>
    <select name="sourceType" class="form-select form-select-sm" style="max-width:200px;" onchange="this.form.submit()">
      <% data.filters.sourceType.options.forEach(function(opt) { %>
        <option value="<%= opt.value %>" <%= opt.value === data.filters.sourceType.value ? "selected" : "" %>><%= opt.label %></option>
      <% }) %>
    </select>
  </form>

  <% if (data.items.length === 0) { %>
    <p class="text-muted">Nemate zabeleženu proviziju.</p>
  <% } else { %>
    <!-- Mobile: card list - a 5-column table has no room to breathe on a phone screen,
         so the amount and status (what someone actually glances at) get top billing,
         with the rest as secondary detail underneath. -->
    <div class="list-group d-lg-none">
      <% data.items.forEach(function(c) { %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-start">
            <div class="fw-semibold"><%= c.izvor %></div>
            <span class="badge bg-secondary"><%= c.status %></span>
          </div>
          <div class="fs-5 fw-bold text-primary"><%= c.iznos %></div>
          <div class="text-muted small"><%= c.osnovnaVrednost %> &middot; <%= c.procenat %></div>
        </div>
      <% }) %>
    </div>

    <!-- Desktop: ordinary table -->
    <div class="card d-none d-lg-block">
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead><tr><th>Izvor</th><th>Osnovna vrednost</th><th>Procenat</th><th>Iznos</th><th>Status</th></tr></thead>
          <tbody>
            <% data.items.forEach(function(c) { %>
              <tr>
                <td><%= c.izvor %></td>
                <td><%= c.osnovnaVrednost %></td>
                <td><%= c.procenat %></td>
                <td><%= c.iznos %></td>
                <td><%= c.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <%- include("../includes/pagination", { pagination: data.pagination }) %>
</main>

<%- include("../includes/portal-footer") %>