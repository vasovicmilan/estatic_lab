<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/moj-nalog" }) %>

<main class="container py-4">
  <%- include("../includes/flash-messages") %>
  <%- include("../includes/components/employee-tabs") %>
  <h1 class="h3 mb-4">Detalji termina</h1>

  <div class="row g-4">
    <!-- Actions first on mobile (order-1) - the whole point of checking this on a
         phone is usually to confirm/reject/complete right away, not to re-read every
         detail first. Desktop keeps the conventional details-left, actions-right
         layout (order-md-2 puts actions back on the right). -->
    <div class="col-md-5 order-1 order-md-2">
      <div class="card">
        <div class="card-body d-flex flex-column gap-2">
          <% if (data.canConfirm) { %>
            <form action="/moj-nalog/termini/<%= data.appointment.id %>/potvrdi" method="POST">
              <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-success w-100">Potvrdi</button>
            </form>
          <% } %>
          <% if (data.canReject) { %>
            <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">Odbij</button>
            <div class="modal fade" id="rejectModal" tabindex="-1">
              <div class="modal-dialog">
                <form action="/moj-nalog/termini/<%= data.appointment.id %>/odbij" method="POST">
                  <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
                  <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Odbij termin</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div>
                    <div class="modal-body">
                      <label class="form-label" for="reject-reason">Razlog (opciono)</label>
                      <textarea id="reject-reason" name="reason" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Otkaži</button>
                      <button type="submit" class="btn btn-danger btn-sm">Potvrdi odbijanje</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% } %>
          <% if (data.canComplete) { %>
            <form action="/moj-nalog/termini/<%= data.appointment.id %>/zavrsi" method="POST">
              <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-primary w-100">Označi kao završen</button>
            </form>
          <% } %>
          <% if (data.canNoShow) { %>
            <button type="button" class="btn btn-outline-warning w-100" data-bs-toggle="modal" data-bs-target="#noShowModal">Klijent se nije pojavio</button>
            <div class="modal fade" id="noShowModal" tabindex="-1">
              <div class="modal-dialog">
                <form action="/moj-nalog/termini/<%= data.appointment.id %>/nije-se-pojavio" method="POST">
                  <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
                  <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Klijent se nije pojavio</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div>
                    <div class="modal-body">
                      <label class="form-label" for="noshow-note">Napomena (opciono)</label>
                      <textarea id="noshow-note" name="note" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Otkaži</button>
                      <button type="submit" class="btn btn-warning btn-sm">Potvrdi</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% } %>
          <% if (data.canReschedule) { %>
            <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#rescheduleModal">Pomeri termin</button>
            <div class="modal fade" id="rescheduleModal" tabindex="-1">
              <div class="modal-dialog">
                <form action="/moj-nalog/termini/<%= data.appointment.id %>/pomeri" method="POST">
                  <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
                  <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Pomeri termin</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button></div>
                    <div class="modal-body">
                      <% if (data.rescheduleWindow === "same_day_only") { %>
                        <p class="text-muted small">Pošto je termin uskoro, novo vreme mora biti isti dan.</p>
                      <% } %>
                      <label class="form-label" for="reschedule-new-start">Novo vreme</label>
                      <input type="datetime-local" id="reschedule-new-start" name="newStartTime" class="form-control" required>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Otkaži</button>
                      <button type="submit" class="btn btn-primary btn-sm">Pomeri</button>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          <% } %>
          <a href="<%= data.backUrl %>" class="btn btn-outline-secondary w-100">Nazad</a>
        </div>
      </div>
    </div>

    <div class="col-md-7 order-2 order-md-1">
      <div class="card">
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-4 text-muted">Klijent</dt><dd class="col-8"><%= data.appointment.klijent.ime %></dd>
            <dt class="col-4 text-muted">Email</dt><dd class="col-8"><%= data.appointment.klijent.email %></dd>
            <dt class="col-4 text-muted">Telefon</dt><dd class="col-8"><%= data.appointment.klijent.telefon || "-" %></dd>
            <dt class="col-4 text-muted">Usluga</dt><dd class="col-8"><%= data.appointment.usluga.naziv %></dd>
            <dt class="col-4 text-muted">Trajanje</dt><dd class="col-8"><%= data.appointment.usluga.trajanje %></dd>
            <dt class="col-4 text-muted">Termin</dt><dd class="col-8"><%= data.appointment.termin.pocetak %> - <%= data.appointment.termin.kraj %></dd>
            <dt class="col-4 text-muted">Status</dt><dd class="col-8"><%= data.appointment.status %></dd>
            <dt class="col-4 text-muted">Cena</dt><dd class="col-8"><%= data.appointment.konacnaCena %></dd>
            <% if (data.appointment.napomenaKlijenta) { %><dt class="col-4 text-muted">Napomena</dt><dd class="col-8"><%= data.appointment.napomenaKlijenta %></dd><% } %>
          </dl>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include("../includes/portal-footer") %>