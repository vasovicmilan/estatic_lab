<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <section class="bg-white pt-5 <%= data.isLandingView ? '' : 'pb-4' %>">
    <div class="container">
      <%- include("../includes/breadcrumbs") %>

      <% if (data.isLandingView) { %>
        <p class="section-eyebrow"><%= data.intro.eyebrow %></p>
        <h1 class="h2 mb-4 shop-intro-title"><%= data.intro.title %></h1>
        <p class="lead text-muted shop-intro-text"><%= data.intro.lead %></p>
        <% data.intro.paragraphs.forEach(function(p) { %>
          <p class="text-muted shop-intro-text"><%= p %></p>
        <% }) %>

        <% if (data.trust && data.trust.length > 0) { %>
          <div class="row g-4 mt-2 mb-4 pb-4 border-bottom">
            <% data.trust.forEach(function(item) { %>
              <div class="col-6 col-md-3">
                <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary-emphasis rounded-circle icon-circle-lg mb-3">
                  <i class="bi <%= item.icon %> fs-4"></i>
                </div>
                <h2 class="h6"><%= item.title %></h2>
                <p class="text-muted small"><%= item.text %></p>
              </div>
            <% }) %>
          </div>
        <% } %>
      <% } else if (data.search) { %>
        <h1 class="h3 mb-1">Rezultati pretrage: "<%= data.search %>"</h1>
        <p class="text-muted mb-4"><%= data.resultCount %> <%= data.resultCount === 1 ? "proizvod pronađen" : "proizvoda pronađeno" %></p>
      <% } else { %>
        <h1 class="h3 mb-2"><%= data.badgeTitle || (data.category ? data.category.naziv : (data.tag ? data.tag.naziv : "Prodavnica")) %></h1>
        <% if (data.subtitle) { %><p class="text-muted mb-4"><%= data.subtitle %></p><% } %>
      <% } %>
    </div>
  </section>

  <%- include("../includes/components/ritual-divider") %>

  <% if (data.categoryTabs && data.categoryTabs.length > 0) { %>
    <nav class="service-filter-bar" aria-label="Filter po kategoriji">
      <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
        <div class="service-filter-scroll flex-grow-1">
          <% data.categoryTabs.forEach(function(tab) { %>
            <a href="<%= tab.href %>" class="filter-pill <%= tab.active ? 'active' : '' %>">
              <%= tab.label %>
              <span class="filter-pill-count">(<%= tab.count %>)</span>
            </a>
          <% }) %>
        </div>
        <form action="/prodavnica" method="GET" role="search" class="shop-search-form">
          <div class="input-group">
            <input type="search" name="search" class="form-control" placeholder="Pretraži proizvode..." aria-label="Pretraži proizvode" value="<%= data.search || '' %>">
            <button type="submit" class="btn btn-primary" aria-label="Pretraži"><i class="bi bi-search" aria-hidden="true"></i></button>
          </div>
        </form>
      </div>
    </nav>
  <% } %>

  <div class="container py-5">
    <% if (data.products && data.products.length > 0) { %>
      <div class="row g-4">
        <% data.products.forEach(function(product) { %>
          <div class="col-md-4">
            <%- include("../includes/components/card-product", { product: product }) %>
          </div>
        <% }) %>
      </div>
      <%- include("../includes/pagination", { pagination: data.pagination }) %>
    <% } else { %>
      <p class="text-muted text-center py-5 mb-0">
        <% if (data.search) { %>Nema proizvoda koji odgovaraju pretrazi "<%= data.search %>".<% } else { %>Nema proizvoda u ovoj kategoriji.<% } %>
      </p>
    <% } %>

    <% if (data.tagChips && data.tagChips.length > 0) { %>
      <% const visibleChips = data.tagChips.slice(0, 14); %>
      <% const restChips = data.tagChips.slice(14); %>
      <div class="card mt-5">
        <div class="card-body p-4">
          <h2 class="h6 mb-3">Pretražite po temi</h2>
          <div class="d-flex flex-wrap gap-2">
            <% visibleChips.forEach(function(chip) { %>
              <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
            <% }) %>
          </div>
          <% if (restChips.length > 0) { %>
            <details class="tag-chips-more">
              <summary>Prikaži sve teme (<%= data.tagChips.length %>)</summary>
              <div class="d-flex flex-wrap gap-2 mt-3">
                <% restChips.forEach(function(chip) { %>
                  <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
                <% }) %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <% if (data.isLandingView && data.faq && data.faq.length > 0) { %>
    <section class="bg-white border-top py-5">
      <div class="container">
        <h2 class="h4 mb-4 text-center">Česta pitanja o kupovini</h2>
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <%- include("../includes/components/faq", { faq: data.faq }) %>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <% if (data.isLandingView && data.latestPosts && data.latestPosts.length > 0) { %>
    <section class="border-top py-5">
      <div class="container">
        <div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
          <div>
            <p class="section-eyebrow mb-2">Sa bloga</p>
            <h2 class="h3 mb-0">Saveti i objašnjenja iz struke</h2>
          </div>
          <a href="/blog" class="fw-semibold text-decoration-none text-primary-emphasis">Svi tekstovi &rarr;</a>
        </div>
        <div class="row g-4">
          <% data.latestPosts.forEach(function(post) { %>
            <div class="col-md-4">
              <%- include("../includes/components/card-post", { post: post }) %>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include("../includes/footer") %>