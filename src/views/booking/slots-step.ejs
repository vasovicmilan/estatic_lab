<%- include("../includes/head") %>
  <%- include("../includes/navigation") %>

    <main class="container py-5">
      <%- include("../includes/breadcrumbs") %>
        <%- include("../includes/flash-messages") %>

          <%- include("../includes/components/booking-progress", { step: 2 }) %>

          <h1 class="h3 mb-4">
            <%= data.service.naziv %> - <%= data.variant.naziv %>
          </h1>

          <form method="GET" class="row g-3 align-items-end mb-4">
            <input type="hidden" name="servicePackageId" value="<%= data.variant.id %>">
            <div class="col-auto">
              <label class="form-label small text-muted" for="slots-date">Datum</label>
              <input type="date" id="slots-date" name="date" class="form-control" value="<%= data.date %>"
                min="<%= new Date().toISOString().slice(0,10) %>" onchange="this.form.submit()">
            </div>
            <% if (data.employees && data.employees.length> 0) { %>
              <div class="col-auto">
                <label class="form-label small text-muted" for="slots-employeeId">Terapeut</label>
                <select id="slots-employeeId" name="employeeId" class="form-select" onchange="this.form.submit()">
                  <option value="" <%=!data.employeeId ? 'selected' : '' %>>Nema preferenciju</option>
                  <% data.employees.forEach(function(emp) { %>
                    <option value="<%= emp.id %>" <%=String(data.employeeId)===String(emp.id) ? 'selected' : '' %>><%=
                        emp.imePrezime %>
                    </option>
                    <% }) %>
                </select>
              </div>
              <% } %>
          </form>

          <% if (data.slots && data.slots.length> 0) { %>
            <% const amSlots=data.slots.filter(function(s) { return s.period==='am' }); const pmSlots=data.slots.filter(function(s) { return s.period==='pm' }); %>
            <% function renderSlotGroup(slotList) { %>
              <div class="row g-2">
                <% slotList.forEach(function(slot) { %>
                  <% const start=new Date(slot.pocetak); const params=new URLSearchParams({ servicePackageId:
                    data.variant.id, startTime: start.toISOString(), employeeId: slot.terapeutId || '' , }); %>
                    <div class="col-auto">
                      <a href="/zakazivanje/<%= data.service.slug %>/podaci?<%= params.toString() %>"
                        class="btn btn-outline-primary mono">
                        <%= slot.vreme %>
                      </a>
                    </div>
                    <% }) %>
              </div>
              <% } %>
                <% if (amSlots.length> 0) { %>
                  <h2 class="h6 text-muted mb-2">Pre podne</h2>
                  <% renderSlotGroup(amSlots) %>
                  <% } %>
                    <% if (pmSlots.length> 0) { %>
                      <h2 class="h6 text-muted mb-2 <%= amSlots.length> 0 ? 'mt-4' : '' %>">Posle podne</h2>
                      <% renderSlotGroup(pmSlots) %>
                      <% } %>
                        <% } else { %>
                          <p class="text-muted">Nema dostupnih termina za izabrani datum. Pokušajte drugi datum.</p>
                          <% } %>

                <a href="<%= data.backUrl %>" class="btn btn-link mt-4">&larr; Nazad na izbor varijante</a>
    </main>

    <%- include("../includes/footer") %>