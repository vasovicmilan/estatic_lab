<%
  const p = typeof pagination !== 'undefined' ? pagination : (typeof data !== 'undefined' ? data.pagination : null);
%>
<%
  const sizes = p && Array.isArray(p.pageSizeOptions) ? p.pageSizeOptions : null;
  const showSizes = !!(sizes && p.total > sizes[0]);
  const showPages = !!(p && p.totalPages > 1);
%>
<% if (p && (showPages || showSizes)) { %>
<div class="list-pagination d-flex flex-column flex-md-row align-items-center <%= showSizes ? 'justify-content-between' : 'justify-content-center' %> gap-3 mt-4">
<% if (showSizes) { %>
  <%
    const sizeUrl = function(size) {
      const params = new URLSearchParams({ ...(p.query || {}), limit: size });
      params.delete(p.pageParam || "page");
      return `${p.basePath}?${params.toString()}`;
    };
    const from = (p.currentPage - 1) * p.limit + 1;
    const to = Math.min(p.currentPage * p.limit, p.total);
  %>
  <div class="d-flex align-items-center flex-wrap gap-2 small text-muted" role="group" aria-label="Broj prikaza po strani">
    <span>Prikazano <%= from %>–<%= to %> od <%= p.total %></span>
    <span class="ms-md-3">Po strani:</span>
    <% sizes.forEach(function(size) { %>
      <a href="<%= sizeUrl(size) %>" class="filter-pill <%= size === p.limit ? 'active' : '' %>" <%= size === p.limit ? 'aria-current=true' : '' %>><%= size %></a>
    <% }) %>
  </div>
<% } %>
<% if (showPages) { %>
<nav aria-label="Paginacija" class="d-flex justify-content-center">
  <ul class="pagination flex-wrap justify-content-center mb-0">
    <%
      const qs = { ...(p.query || {}) };
      const pageParam = p.pageParam || "page";
      function pageUrl(page) {
        const params = new URLSearchParams({ ...qs, [pageParam]: page });
        return `${p.basePath}?${params.toString()}`;
      }

      // Windowed page list instead of 1..totalPages rendered in full - with
      // any real amount of data (logs, orders, appointments easily reach
      // 20-40+ pages) that was a non-wrapping row of that many buttons,
      // which is exactly what was overflowing the screen on phone. Shows
      // first, last, and a small window around the current page, with "..."
      // standing in for whatever's skipped - same page links either way,
      // just not all of them rendered as separate buttons at once.
      const windowSize = 1;
      const pageNumbers = [];
      for (let i = 1; i <= p.totalPages; i++) {
        const isEdge = i === 1 || i === p.totalPages;
        const isNearCurrent = Math.abs(i - p.currentPage) <= windowSize;
        if (isEdge || isNearCurrent) pageNumbers.push(i);
      }
    %>
    <li class="page-item <%= p.currentPage <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="<%= pageUrl(Math.max(1, p.currentPage - 1)) %>">Prethodna</a>
    </li>
    <%
      let previousPage = 0;
      pageNumbers.forEach(function(i) {
        if (i - previousPage > 1) { %>
          <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
        <% }
        previousPage = i;
    %>
      <li class="page-item <%= i === p.currentPage ? 'active' : '' %>">
        <a class="page-link" href="<%= pageUrl(i) %>"><%= i %></a>
      </li>
    <% }) %>
    <li class="page-item <%= p.currentPage >= p.totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="<%= pageUrl(Math.min(p.totalPages, p.currentPage + 1)) %>">Sledeća</a>
    </li>
  </ul>
</nav>
<% } %>
</div>
<% } %>