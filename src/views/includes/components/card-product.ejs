<a href="/prodavnica/<%= product.slug %>" class="card h-100 shadow-sm text-decoration-none text-dark hover-lift">
  <div class="position-relative">
    <% if (product.slika && product.slika.url) { %>
      <img src="<%= product.slika.url %>" class="card-img-top product-card-img" alt="<%= product.slika.alt || product.naziv %>" loading="lazy" decoding="async">
    <% } %>
    <% if (product.oznaka) { %>
      <span class="position-absolute top-0 start-0 m-2 badge <%= product.oznakaRaw === 'sale' ? 'bg-danger' : 'bg-primary' %>"><%= product.oznaka %></span>
    <% } %>
  </div>
  <div class="card-body d-flex flex-column">
    <% if (!product.naStanju) { %><span class="badge bg-secondary mb-2 align-self-start">Nema na stanju</span><% } %>
    <h3 class="h5"><%= product.naziv %></h3>
    <p class="text-muted small flex-grow-1"><%= product.kratakOpis %></p>
    <div class="d-flex justify-content-between align-items-center mt-2">
      <strong><%= product.cena %></strong>
      <span class="btn btn-outline-primary btn-sm">Detalji</span>
    </div>
  </div>
</a>