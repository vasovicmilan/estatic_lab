<div class="card h-100 shadow-sm hover-lift">
  <% const isEsma = service.kategorije && service.kategorije.some(function(k) { return String(k).toUpperCase() === "ESMA"; }); %>
  <% if (service.slika && service.slika.url) { %>
    <div class="position-relative">
      <img src="<%= service.slika.url %>" class="card-img-top service-card-img" alt="<%= service.slika.alt || service.naziv %>" loading="lazy" decoding="async">
      <% if (service.istaknuto) { %>
        <span class="position-absolute top-0 start-0 m-3 badge text-bg-light">Istaknuto</span>
      <% } %>
      <% if (isEsma) { %>
        <span class="position-absolute top-0 end-0 m-3 badge text-bg-dark bg-opacity-75">ESMA</span>
      <% } %>
    </div>
  <% } %>
  <div class="card-body d-flex flex-column">
    <% if (!service.slika || !service.slika.url) { %>
      <% if (service.istaknuto) { %><span class="badge bg-primary mb-2 align-self-start">Istaknuto</span><% } %>
    <% } %>
    <h3 class="h5"><a href="/usluge/<%= service.slug %>" class="text-decoration-none text-dark"><%= service.naziv %></a></h3>
    <p class="text-muted small flex-grow-1"><%= service.kratakOpis %></p>
    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
      <strong class="text-primary-emphasis price-mono"><%= service.cena %></strong>
      <a href="/usluge/<%= service.slug %>" class="btn btn-outline-primary btn-sm"><%= service.cta || "Detalji" %></a>
    </div>
  </div>
</div>