<form method="GET" class="d-flex admin-list-search" role="search">
  <input
    type="search"
    name="search"
    class="form-control form-control-sm"
    placeholder="Pretraga..."
    aria-label="Pretraga"
    value="<%= typeof search !== 'undefined' ? search : '' %>"
  >
  <button type="submit" class="btn btn-outline-secondary btn-sm ms-1" aria-label="Pretraži">
    <i class="bi bi-search" aria-hidden="true"></i>
  </button>
</form>