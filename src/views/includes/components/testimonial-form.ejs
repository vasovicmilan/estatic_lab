<%
  // Optional locals passed in via include("...", { serviceId, packageId, productId }) -
  // ties the testimonial to whichever service/package/product detail page it's on.
  // None are required: on general pages (e.g. home) all three are simply omitted.
  const _serviceId = typeof serviceId !== "undefined" ? serviceId : null;
  const _packageId = typeof packageId !== "undefined" ? packageId : null;
  const _productId = typeof productId !== "undefined" ? productId : null;
%>
<div class="card shadow-sm">
  <div class="card-body p-4">
    <h2 class="h5 mb-3">Ostavite utisak</h2>

    <form action="/testimonials/posalji" method="POST">
      <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
      <input type="text" name="nickname" class="d-none" tabindex="-1" autocomplete="off">
      <% if (_serviceId) { %><input type="hidden" name="service" value="<%= _serviceId %>"><% } %>
      <% if (_packageId) { %><input type="hidden" name="package" value="<%= _packageId %>"><% } %>
      <% if (_productId) { %><input type="hidden" name="product" value="<%= _productId %>"><% } %>

      <% if (typeof isLoggedIn !== "undefined" && isLoggedIn && user) { %>
        <%
          const _fullName = `${user.firstName || ""} ${user.lastName || ""}`.trim();
        %>
        <input type="hidden" name="name" value="<%= _fullName %>">
        <input type="hidden" name="email" value="<%= user.email %>">
        <p class="text-muted small mb-3">Ostavljate utisak kao <strong><%= _fullName %></strong>.</p>
      <% } else { %>
        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label" for="testimonial-name">Ime</label>
            <input type="text" id="testimonial-name" name="name" class="form-control" required minlength="2" maxlength="100">
          </div>
          <div class="col-md-6">
            <label class="form-label" for="testimonial-email">Email (opciono)</label>
            <input type="email" id="testimonial-email" name="email" class="form-control">
          </div>
        </div>
      <% } %>

      <div class="mb-3">
        <fieldset class="border-0 p-0 m-0">
          <legend class="form-label h6 fs-6 fw-normal mb-2">Ocena</legend>
          <div class="star-rating-input" role="radiogroup" aria-label="Ocena, 1 do 5 zvezdica">
            <input type="radio" id="testimonial-rating-5" name="rating" value="5" required aria-label="5 zvezdica - Odlično">
            <label for="testimonial-rating-5">★</label>
            <input type="radio" id="testimonial-rating-4" name="rating" value="4" aria-label="4 zvezdice - Vrlo dobro">
            <label for="testimonial-rating-4">★</label>
            <input type="radio" id="testimonial-rating-3" name="rating" value="3" aria-label="3 zvezdice - Dobro">
            <label for="testimonial-rating-3">★</label>
            <input type="radio" id="testimonial-rating-2" name="rating" value="2" aria-label="2 zvezdice - Osrednje">
            <label for="testimonial-rating-2">★</label>
            <input type="radio" id="testimonial-rating-1" name="rating" value="1" aria-label="1 zvezdica - Loše">
            <label for="testimonial-rating-1">★</label>
          </div>
        </fieldset>
      </div>

      <div class="mb-3">
        <label class="form-label" for="testimonial-message">Vaš utisak</label>
        <textarea id="testimonial-message" name="message" class="form-control" rows="4" required minlength="10" maxlength="1000"></textarea>
      </div>

      <div class="mb-3 form-check">
        <input type="checkbox" id="testimonial-consent" name="consentGiven" class="form-check-input" required>
        <label class="form-check-label small" for="testimonial-consent">
          Saglasan/na sam da se moje ime, ocena i tekst utiska javno objave na sajtu Estetik Lab. Pogledajte
          <a href="/politika-privatnosti" target="_blank" rel="noopener">politiku privatnosti</a>.
        </label>
      </div>

      <button type="submit" class="btn btn-primary">Pošalji utisak</button>
      <p class="text-muted small mt-2 mb-0">Utisak će biti objavljen nakon provere.</p>
    </form>
  </div>
</div>