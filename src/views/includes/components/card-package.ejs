<div class="card h-100 shadow-sm <%= pkg.najbolji ? 'border-primary' : '' %>">
  <% if (pkg.slika && pkg.slika.url) {
       const v = pkg.slika.variants || {};
       const srcsetParts = [];
       if (v.thumb) srcsetParts.push(`${v.thumb} 300w`);
       if (v.medium) srcsetParts.push(`${v.medium} 800w`);
  %>
    <img
      src="<%= pkg.slika.url %>"
      <% if (srcsetParts.length > 1) { %>srcset="<%= srcsetParts.join(', ') %>" sizes="(min-width: 768px) 33vw, 100vw"<% } %>
      class="card-img-top package-card-img" alt="<%= pkg.slika.alt || pkg.naziv %>" loading="lazy" decoding="async">
  <% } %>
  <div class="card-body d-flex flex-column">
    <% if (pkg.najbolji || pkg.oznaka) { %>
      <span class="badge <%= pkg.najbolji ? 'text-bg-warning' : 'text-bg-secondary' %> mb-2 align-self-start"><%= pkg.oznaka || "Najbolja vrednost" %></span>
    <% } %>
    <h3 class="h5"><a href="/paketi/<%= pkg.slug %>" class="text-decoration-none text-dark"><%= pkg.naziv %></a></h3>
    <p class="text-muted small flex-grow-1"><%= pkg.kratakOpis %></p>

    <% if (pkg.stavke && pkg.stavke.length > 0) { %>
      <ul class="list-unstyled small mb-3">
        <% pkg.stavke.forEach(function(stavka) { %>
          <li><i class="bi bi-check2 text-primary me-1"></i><%= stavka %></li>
        <% }) %>
      </ul>
    <% } %>

    <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
      <div>
        <strong class="price-mono"><%= pkg.cena %></strong>
        <% if (pkg.staraCena) { %><span class="text-muted text-decoration-line-through small ms-1 price-mono"><%= pkg.staraCena %></span><% } %>
      </div>
      <a href="/paketi/<%= pkg.slug %>" class="btn btn-outline-primary btn-sm">Detalji</a>
    </div>
  </div>
</div>