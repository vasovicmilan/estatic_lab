<div class="card h-100 shadow-sm text-center hover-lift">
  <% if (expert.slika && expert.slika.url) {
       const v = expert.slika.variants || {};
       const srcsetParts = [];
       if (v.thumb) srcsetParts.push(`${v.thumb} 300w`);
       if (v.medium) srcsetParts.push(`${v.medium} 800w`);
  %>
    <img
      src="<%= expert.slika.url %>"
      <% if (srcsetParts.length > 1) { %>srcset="<%= srcsetParts.join(', ') %>" sizes="(min-width: 768px) 33vw, 100vw"<% } %>
      class="card-img-top expert-card-img" alt="<%= expert.slika.alt || expert.imePrezime %>" loading="lazy" decoding="async">
  <% } %>
  <div class="card-body">
    <h3 class="h6 mb-1"><a href="/nas-tim/<%= expert.slug %>" class="text-decoration-none text-dark"><%= expert.imePrezime %></a></h3>
    <div class="text-muted small mb-2 mono text-uppercase"><%= expert.titula %></div>
    <p class="small"><%= expert.kratkaBiografija %></p>
  </div>
</div>