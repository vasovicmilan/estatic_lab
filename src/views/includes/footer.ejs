<footer class="bg-dark text-light py-5 mt-auto">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h5 class="fst-italic">Estetik Lab</h5>
        <!-- .text-secondary (solid #6b5b4d) measured only 2.19:1 against this dark
             background, a real WCAG AA failure - .text-white + .text-opacity-75
             (native Bootstrap utilities, no custom CSS needed) measures 7.77:1. -->
        <p class="text-white text-opacity-75 small">Vaš prostor za opuštanje i negu.</p>
      </div>
      <div class="col-md-4">
        <h6>Brzi linkovi</h6>
        <!-- mb-2 on each <li> gives stacked links real vertical spacing - previously
             touching directly, which fails WCAG 2.5.8's touch-target-size/spacing
             check on top of the same contrast problem as above. -->
        <ul class="list-unstyled small">
          <li class="mb-2"><a href="/usluge" class="text-white text-opacity-75 text-decoration-none">Usluge</a></li>
          <li class="mb-2"><a href="/paketi" class="text-white text-opacity-75 text-decoration-none">Paketi</a></li>
          <li class="mb-2"><a href="/blog" class="text-white text-opacity-75 text-decoration-none">Blog</a></li>
          <li class="mb-2"><a href="/nas-tim" class="text-white text-opacity-75 text-decoration-none">Naš tim</a></li>
          <li class="mb-2"><a href="/partnerski-program" class="text-white text-opacity-75 text-decoration-none">Partnerski program</a></li>
          <li class="mb-2"><a href="/kontakt" class="text-white text-opacity-75 text-decoration-none">Kontakt</a></li>
          <li><a href="/o-nama" class="text-white text-opacity-75 text-decoration-none">O nama</a></li>
        </ul>
      </div>
      <div class="col-md-4">
        <h6>Prijavite se na newsletter</h6>
        <form action="/newsletter/prijava" method="POST">
          <input type="text" name="nickname" class="d-none" tabindex="-1" autocomplete="off">
          <div class="d-flex gap-2">
            <input type="email" name="email" class="form-control form-control-sm" placeholder="vas@email.com" aria-label="Email adresa za newsletter" required>
            <input type="hidden" name="CSRFToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="btn btn-primary btn-sm text-nowrap">Prijavi se</button>
          </div>
          <div class="form-check mt-2">
            <input type="checkbox" name="consent" value="true" class="form-check-input" id="newsletterConsent" required>
            <label class="form-check-label text-white text-opacity-75 small" for="newsletterConsent">
              Slažem se sa primanjem newsletter-a i <a href="/politika-privatnosti" class="text-white text-decoration-underline">politikom privatnosti</a>.
            </label>
          </div>
        </form>
        <!-- d-flex + gap-3 gives the two links real separation instead of a bare
             middot with a couple of px of whitespace on either side. -->
        <div class="mt-3 small d-flex flex-wrap gap-3">
          <a href="/politika-privatnosti" class="text-white text-opacity-75 text-decoration-none">Politika privatnosti</a>
          <a href="/uslovi-koriscenja" class="text-white text-opacity-75 text-decoration-none">Uslovi korišćenja</a>
        </div>
      </div>
    </div>
    <hr class="border-secondary">
    <% if (typeof business !== "undefined" && business) { %>
      <p class="text-white text-opacity-75 small mb-1">
        <%= business.legalName %><% if (business.address && business.address.full) { %>, <%= business.address.full %><% } %>
        <% if (business.taxId) { %> · PIB: <%= business.taxId %><% } %>
        <% if (business.registrationNumber) { %> · MB: <%= business.registrationNumber %><% } %>
      </p>
    <% } %>
    <p class="text-white text-opacity-75 small mb-1">&copy; <%= new Date().getFullYear() %> Estetik Lab. Sva prava zadržana.</p>
    <p class="text-white text-opacity-75 small mb-0">Napravio Arius Systems</p>
  </div>
</footer>

<!-- Shared confirmation modal - used by every form with a data-confirm="..." attribute
     (delete buttons, cancel appointment, deactivate account, etc.) via main.js -->
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Potvrda</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
      </div>
      <div class="modal-body">
        <p id="confirmActionMessage" class="mb-0"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Otkaži</button>
        <button type="button" class="btn btn-danger" id="confirmActionButton">Potvrdi</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="imageLightboxModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content bg-transparent border-0">
      <button type="button" class="btn-close btn-close-white ms-auto m-2" data-bs-dismiss="modal" aria-label="Zatvori"></button>
      <div class="modal-body p-0 text-center">
        <img id="imageLightboxImg" src="" alt="" class="img-fluid rounded">
      </div>
    </div>
  </div>
</div>

<%- include("./components/cookie-consent") %>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
</body>
</html>