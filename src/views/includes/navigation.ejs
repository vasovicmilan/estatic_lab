<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
  <% const currentPath = typeof locals.currentPath !== "undefined" ? locals.currentPath : ""; %>
  <div class="container-fluid">
    <a class="navbar-brand fw-bold fst-italic" href="/">Estetik Lab</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Uključi/isključi navigaciju">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Početna</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/usluge') ? 'active' : '' %>" href="/usluge">Usluge</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/paketi') ? 'active' : '' %>" href="/paketi">Paketi</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/prodavnica') ? 'active' : '' %>" href="/prodavnica">Prodavnica</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/blog') ? 'active' : '' %>" href="/blog">Blog</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/nas-tim') ? 'active' : '' %>" href="/nas-tim">Naš tim</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/kontakt') ? 'active' : '' %>" href="/kontakt">Kontakt</a></li>
      </ul>

      <% const isAdmin = user?.roleName === 'admin' || user?.permissions?.includes('access_admin_panel'); %>
      <div class="d-flex align-items-center gap-2">
        <a href="/usluge" class="btn btn-primary btn-sm">Zakažite termin</a>

        <a href="/korpa" class="btn btn-outline-secondary btn-sm position-relative <%= currentPath?.startsWith('/korpa') ? 'active' : '' %>" aria-label="Korpa">
          <i class="bi bi-cart3" aria-hidden="true"></i>
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= cartCount > 99 ? '99+' : cartCount %>
              <span class="visually-hidden">stavki u korpi</span>
            </span>
          <% } %>
        </a>

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
          <!-- Desktop only - the floating dropdown works fine here, this isn't what
               was broken. Hidden on mobile so it can't fall into the static-positioning
               rule below (see the .navbar-collapse .dropdown-menu comment in styles.css) -
               that rule is still needed for OTHER dropdowns in a scrollable open mobile
               menu, just not a good fit for a 12-item account menu specifically. -->
          <div class="dropdown d-none d-lg-block">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle"></i> <%= user?.firstName %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if (isAdmin) { %>
                <li><a class="dropdown-item" href="/admin">Admin panel</a></li>
                <li><a class="dropdown-item" href="/admin/profil">Admin profil</a></li>
              <% } %>

              <% if (user?.isEmployee) { %>
                <li><a class="dropdown-item" href="/moj-nalog">Moj kalendar</a></li>
                <li><a class="dropdown-item" href="/moj-nalog/termini">Moji termini (zaposleni)</a></li>
                <% if (user.isPartner) { %>
                  <li><a class="dropdown-item" href="/moj-partner-nalog">Partnerski nalog</a></li>
                <% } %>
                <li><a class="dropdown-item" href="/moj-nalog/profil">Profil zaposlenog</a></li>
              <% } %>

              <% if (isAdmin || user?.isEmployee) { %>
                <li><hr class="dropdown-divider"></li>
              <% } %>

              <li><a class="dropdown-item" href="/nalog">Moj profil</a></li>
              <li><a class="dropdown-item" href="/nalog/termini">Moji termini</a></li>
              <li><a class="dropdown-item" href="/nalog/porudzbine">Moje porudžbine</a></li>
              <li><a class="dropdown-item" href="/nalog/adrese">Moje adrese</a></li>
              <li><a class="dropdown-item" href="/korpa">Korpa</a></li>
              <li><a class="dropdown-item" href="/nalog/podesavanja">Podešavanja</a></li>

              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/odjava">Odjava</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/prijava" class="btn btn-outline-secondary btn-sm">Prijava</a>
          <a href="/registracija" class="btn btn-outline-primary btn-sm">Registracija</a>
        <% } %>
      </div>

      <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
        <!-- Mobile only - a real dropdown-in-a-scrollable-collapse doesn't work well
             for 12 items (see the styles.css comment on .navbar-collapse .dropdown-menu:
             it has to render inline/static there to avoid getting clipped, which then
             visually reflows everything after it in the flex row above). This is a
             flat, always-visible, clearly labeled section instead of a dropdown
             pretending to be inline - no floating positioning to fight with, and
             grouping the 12 links under a few small headers is easier to scan than one
             undifferentiated list. -->
        <div class="d-lg-none border-top mt-3 pt-3">
          <div class="d-flex align-items-center gap-2 px-1 mb-2 text-body">
            <i class="bi bi-person-circle fs-5" aria-hidden="true"></i>
            <span class="fw-semibold"><%= user?.firstName %></span>
          </div>

          <% if (isAdmin) { %>
            <div class="text-uppercase text-muted px-1 mb-1 mobile-account-heading">Admin</div>
            <a class="nav-link px-1" href="/admin">Admin panel</a>
            <a class="nav-link px-1" href="/admin/profil">Admin profil</a>
          <% } %>

          <% if (user?.isEmployee) { %>
            <div class="text-uppercase text-muted px-1 mb-1 mt-2 mobile-account-heading">Zaposleni</div>
            <a class="nav-link px-1" href="/moj-nalog">Moj kalendar</a>
            <a class="nav-link px-1" href="/moj-nalog/termini">Moji termini (zaposleni)</a>
            <% if (user.isPartner) { %>
              <a class="nav-link px-1" href="/moj-partner-nalog">Partnerski nalog</a>
            <% } %>
            <a class="nav-link px-1" href="/moj-nalog/profil">Profil zaposlenog</a>
          <% } %>

          <div class="text-uppercase text-muted px-1 mb-1 mt-2 mobile-account-heading">Nalog</div>
          <a class="nav-link px-1" href="/nalog">Moj profil</a>
          <a class="nav-link px-1" href="/nalog/termini">Moji termini</a>
          <a class="nav-link px-1" href="/nalog/porudzbine">Moje porudžbine</a>
          <a class="nav-link px-1" href="/nalog/adrese">Moje adrese</a>
          <a class="nav-link px-1" href="/korpa">Korpa</a>
          <a class="nav-link px-1" href="/nalog/podesavanja">Podešavanja</a>

          <a class="nav-link px-1 mt-2 pt-2 border-top text-danger" href="/odjava">Odjava</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin')) {
  // 22 flat items in one row stopped being scannable a while ago - grouped here
  // into logical dropdowns instead. Data-driven (not hand-written per group) so
  // adding a future admin section is a one-line addition to a group's `items`
  // array, not another copy-pasted <li> - same pattern as employee/partner/
  // user-tabs.ejs use for the portal nav.
  const adminNavGroups = [
    {
      label: "Zakazivanje", icon: "bi-calendar-check",
      items: [
        { href: "/admin/termini", label: "Termini", icon: "bi-calendar-check" },
        { href: "/admin/resursi", label: "Resursi", icon: "bi-grid-3x3-gap" },
      ],
    },
    {
      label: "Katalog", icon: "bi-heart-pulse",
      items: [
        { href: "/admin/usluge", label: "Usluge", icon: "bi-heart-pulse" },
        { href: "/admin/paketi", label: "Paketi", icon: "bi-box-seam" },
        { href: "/admin/kupljeni-paketi", label: "Kupljeni paketi", icon: "bi-bag-check" },
        { href: "/admin/kategorije", label: "Kategorije", icon: "bi-tags" },
        { href: "/admin/tagovi", label: "Tagovi", icon: "bi-tag" },
      ],
    },
    {
      label: "Prodavnica", icon: "bi-shop",
      items: [
        { href: "/admin/proizvodi", label: "Proizvodi", icon: "bi-box2-heart" },
        { href: "/admin/porudzbine", label: "Porudžbine", icon: "bi-receipt" },
        { href: "/admin/privremene-porudzbine", label: "Privremene porudžbine", icon: "bi-hourglass-split" },
        { href: "/admin/kuponi", label: "Kuponi", icon: "bi-ticket-perforated" },
      ],
    },
    {
      label: "Tim", icon: "bi-people",
      items: [
        { href: "/admin/zaposleni", label: "Zaposleni", icon: "bi-person-badge" },
        { href: "/admin/eksperti", label: "Eksperti", icon: "bi-award" },
        { href: "/admin/korisnici", label: "Korisnici", icon: "bi-people" },
      ],
    },
    {
      label: "Partnerski program", icon: "bi-diagram-3",
      items: [
        { href: "/admin/partneri", label: "Partneri", icon: "bi-person-vcard" },
        { href: "/admin/isplate", label: "Isplate", icon: "bi-cash-coin" },
      ],
    },
    {
      label: "Sadržaj i marketing", icon: "bi-newspaper",
      items: [
        { href: "/admin/blog", label: "Blog", icon: "bi-newspaper" },
        { href: "/admin/kontakt", label: "Kontakt", icon: "bi-envelope-paper" },
        { href: "/admin/newsletter", label: "Newsletter", icon: "bi-send" },
        { href: "/admin/testimoniali", label: "Testimoniali", icon: "bi-star" },
      ],
    },
    {
      label: "Sistem", icon: "bi-gear",
      items: [
        { href: "/admin/logovi", label: "Logovi", icon: "bi-clipboard-data" },
        { href: "/admin/role", label: "Role", icon: "bi-shield-lock" },
      ],
    },
  ];
  function isGroupActive(group) {
    return group.items.some((item) => currentPath.startsWith(item.href));
  }
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Uključi/isključi admin navigaciju">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="adminNav">
      <ul class="navbar-nav flex-wrap">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin"><i class="bi bi-speedometer2 me-1"></i>Početna</a></li>
        <% adminNavGroups.forEach(function(group) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= isGroupActive(group) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi <%= group.icon %> me-1"></i><%= group.label %>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark">
              <% group.items.forEach(function(item) { %>
                <li><a class="dropdown-item <%= currentPath.startsWith(item.href) ? 'active' : '' %>" href="<%= item.href %>"><i class="bi <%= item.icon %> me-2"></i><%= item.label %></a></li>
              <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</nav>
<% } %>