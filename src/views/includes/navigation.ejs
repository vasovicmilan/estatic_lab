<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
  <% const currentPath = typeof locals.currentPath !== "undefined" ? locals.currentPath : ""; %>
  <div class="container-fluid">
    <a class="navbar-brand fst-italic d-flex align-items-center gap-2" href="/">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 1C10 6 15 8 19 8C15 8 10 10 10 19C10 10 5 8 1 8C5 8 10 6 10 1Z" fill="var(--bs-primary)"/></svg>
      <%= business.name %>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Uključi/isključi navigaciju">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Početna</a></li>
        <% if (features.booking) { %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/usluge') ? 'active' : '' %>" href="/usluge">Usluge</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/paketi') ? 'active' : '' %>" href="/paketi">Paketi</a></li>
        <% } %>
        <% if (features.shop) { %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/prodavnica') ? 'active' : '' %>" href="/prodavnica">Prodavnica</a></li>
        <% } %>
        <% if (features.blog) { %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/blog') ? 'active' : '' %>" href="/blog">Blog</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/nas-tim') ? 'active' : '' %>" href="/nas-tim">Naš tim</a></li>
        <% if (features.partners) { %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/partnerski-program') ? 'active' : '' %>" href="/partnerski-program">Partnerski program</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link <%= currentPath?.startsWith('/kontakt') ? 'active' : '' %>" href="/kontakt">Kontakt</a></li>
        <%
          // Secondary pages that used to be reachable only from the footer. On desktop they
          // sit in a "Više" dropdown (the main row is already full at lg width); on mobile
          // they are plain flat links in the open menu - same split as the account menu below.
          const moreLinks = [
            { href: "/o-nama", label: "O nama" },
            { href: "/saradnici", label: "Naši saradnici" },
            { href: "/faq", label: "Česta pitanja" },
            { href: "/uputstva", label: "Uputstva" },
          ];
          const moreActive = moreLinks.some((l) => currentPath?.startsWith(l.href));
        %>
        <li class="nav-item dropdown d-none d-lg-block">
          <a class="nav-link dropdown-toggle <%= moreActive ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Više</a>
          <ul class="dropdown-menu">
            <% moreLinks.forEach(function(l) { %>
              <li><a class="dropdown-item <%= currentPath?.startsWith(l.href) ? 'active' : '' %>" href="<%= l.href %>"><%= l.label %></a></li>
            <% }) %>
          </ul>
        </li>
        <% moreLinks.forEach(function(l) { %>
          <li class="nav-item d-lg-none"><a class="nav-link <%= currentPath?.startsWith(l.href) ? 'active' : '' %>" href="<%= l.href %>"><%= l.label %></a></li>
        <% }) %>
      </ul>

      <% const isAdmin = user?.roleName === 'admin' || user?.permissions?.includes('access_admin_panel'); %>
      <div class="d-flex align-items-center gap-2">
        <% if (features.booking) { %>
        <a href="/usluge" class="btn btn-primary btn-sm">Zakažite termin</a>
        <% } %>

        <% if (features.shop) { %>
        <a href="/korpa" class="btn btn-outline-secondary btn-sm position-relative <%= currentPath?.startsWith('/korpa') ? 'active' : '' %>" aria-label="Korpa">
          <i class="bi bi-cart3" aria-hidden="true"></i>
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= cartCount > 99 ? '99+' : cartCount %>
              <span class="visually-hidden">stavki u korpi</span>
            </span>
          <% } %>
        </a>
        <% } %>

        <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
          <!-- Desktop only - the floating dropdown works fine here, this isn't what
               was broken. Hidden on mobile so it can't fall into the static-positioning
               rule below (see the .navbar-collapse .dropdown-menu comment in styles.css) -
               that rule is still needed for OTHER dropdowns in a scrollable open mobile
               menu, just not a good fit for a 12-item account menu specifically. -->
          <div class="dropdown d-none d-lg-block">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle"></i> <%= user?.firstName %>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <% if (isAdmin) { %>
                <li><a class="dropdown-item" href="/admin">Admin panel</a></li>
                <li><a class="dropdown-item" href="/admin/profil">Admin profil</a></li>
              <% } %>

              <% if (user?.isEmployee) { %>
                <!-- One entry point, not three - once inside /moj-nalog, its own
                     pills-nav (desktop) / bottom tab bar (mobile) already covers
                     Termini/Profil, so listing them again here is the same
                     destination reachable two ways for no reason. -->
                <li><a class="dropdown-item" href="/moj-nalog">Moj kalendar</a></li>
              <% } %>

              <% if (isAdmin || user?.isEmployee) { %>
                <li><hr class="dropdown-divider"></li>
              <% } %>

              <li><a class="dropdown-item" href="/nalog">Moj profil</a></li>
              <% if (features.booking) { %>
              <li><a class="dropdown-item" href="/nalog/termini">Moji termini</a></li>
              <% } %>
              <% if (features.shop) { %>
              <li><a class="dropdown-item" href="/nalog/porudzbine">Moje porudžbine</a></li>
              <li><a class="dropdown-item" href="/nalog/adrese">Moje adrese</a></li>
              <li><a class="dropdown-item" href="/korpa">Korpa</a></li>
              <% } %>
              <li><a class="dropdown-item" href="/nalog/podesavanja">Podešavanja</a></li>
              <% if (user?.isPartner) { %>
                <li><a class="dropdown-item" href="/moj-partner-nalog">Partnerski nalog</a></li>
              <% } %>

              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/odjava">Odjava</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/prijava" class="btn btn-outline-secondary btn-sm">Prijava</a>
          <a href="/registracija" class="btn btn-outline-primary btn-sm">Registracija</a>
        <% } %>
      </div>

      <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
        <!-- Mobile only - a real dropdown-in-a-scrollable-collapse doesn't work well
             for 12 items (see the styles.css comment on .navbar-collapse .dropdown-menu:
             it has to render inline/static there to avoid getting clipped, which then
             visually reflows everything after it in the flex row above). This is a
             flat, always-visible, clearly labeled section instead of a dropdown
             pretending to be inline - no floating positioning to fight with, and
             grouping the 12 links under a few small headers is easier to scan than one
             undifferentiated list. -->
        <div class="d-lg-none mobile-account">
          <div class="mobile-account-user">
            <span class="mobile-account-avatar" aria-hidden="true"><%= (user?.firstName || "?").charAt(0).toUpperCase() %></span>
            <div>
              <div class="mobile-account-name"><%= user?.firstName %></div>
              <div class="mobile-account-hint">Moj nalog</div>
            </div>
          </div>

          <% if (isAdmin) { %>
            <div class="text-uppercase mobile-account-heading">Admin</div>
            <div class="mobile-account-group">
              <a class="nav-link" href="/admin"><i class="bi bi-speedometer2" aria-hidden="true"></i>Admin panel</a>
              <a class="nav-link" href="/admin/profil"><i class="bi bi-shield-lock" aria-hidden="true"></i>Admin profil</a>
            </div>
          <% } %>

          <% if (user?.isEmployee) { %>
            <div class="text-uppercase mobile-account-heading">Zaposleni</div>
            <div class="mobile-account-group">
              <a class="nav-link" href="/moj-nalog"><i class="bi bi-calendar3" aria-hidden="true"></i>Moj kalendar</a>
            </div>
          <% } %>

          <div class="text-uppercase mobile-account-heading">Nalog</div>
          <div class="mobile-account-group">
            <a class="nav-link" href="/nalog"><i class="bi bi-person" aria-hidden="true"></i>Moj profil</a>
            <% if (features.booking) { %>
            <a class="nav-link" href="/nalog/termini"><i class="bi bi-calendar3" aria-hidden="true"></i>Moji termini</a>
            <% } %>
            <% if (features.shop) { %>
            <a class="nav-link" href="/nalog/porudzbine"><i class="bi bi-box-seam" aria-hidden="true"></i>Moje porudžbine</a>
            <a class="nav-link" href="/nalog/adrese"><i class="bi bi-geo-alt" aria-hidden="true"></i>Moje adrese</a>
            <a class="nav-link" href="/korpa"><i class="bi bi-cart3" aria-hidden="true"></i>Korpa</a>
            <% } %>
            <a class="nav-link" href="/nalog/podesavanja"><i class="bi bi-gear" aria-hidden="true"></i>Podešavanja</a>
            <% if (user?.isPartner) { %>
              <a class="nav-link" href="/moj-partner-nalog"><i class="bi bi-person-circle" aria-hidden="true"></i>Partnerski nalog</a>
            <% } %>
          </div>

          <a class="mobile-account-logout" href="/odjava">Odjava</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>

<% if (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin')) {
  // 22 flat items in one row stopped being scannable a while ago - grouped here
  // into logical dropdowns instead. Data-driven (not hand-written per group) so
  // adding a future admin section is a one-line addition to a group's `items`
  // array, not another copy-pasted <li> - same pattern as employee/partner/
  // user-tabs.ejs use for the portal nav.
  const adminNavGroups = [
    {
      label: "Zakazivanje", icon: "bi-calendar-check",
      items: [
        { href: "/admin/termini", permission: "manage_appointments_all", label: "Termini", icon: "bi-calendar-check", feature: features.booking },
        { href: "/admin/resursi", permission: "manage_resources", label: "Resursi", icon: "bi-grid-3x3-gap", feature: features.booking },
      ],
    },
    {
      label: "Katalog", icon: "bi-heart-pulse",
      items: [
        { href: "/admin/usluge", permission: "manage_services", label: "Usluge", icon: "bi-heart-pulse", feature: features.booking },
        { href: "/admin/paketi", permission: "manage_packages", label: "Paketi", icon: "bi-box-seam", feature: features.booking },
        { href: "/admin/kupljeni-paketi", permission: "manage_appointments_all", label: "Kupljeni paketi", icon: "bi-bag-check", feature: features.booking },
        { href: "/admin/kategorije", permission: "manage_taxonomy", label: "Kategorije", icon: "bi-tags" },
        { href: "/admin/tagovi", permission: "manage_taxonomy", label: "Tagovi", icon: "bi-tag" },
      ],
    },
    {
      label: "Prodavnica", icon: "bi-shop",
      items: [
        { href: "/admin/proizvodi", permission: "manage_products", label: "Proizvodi", icon: "bi-box2-heart", feature: features.shop },
        { href: "/admin/porudzbine", permission: "manage_orders", label: "Porudžbine", icon: "bi-receipt", feature: features.shop },
        { href: "/admin/privremene-porudzbine", permission: "manage_orders", label: "Privremene porudžbine", icon: "bi-hourglass-split", feature: features.shop },
        { href: "/admin/kuponi", permission: "manage_coupons", label: "Kuponi", icon: "bi-ticket-perforated", feature: features.coupons },
      ],
    },
    {
      label: "Tim", icon: "bi-people",
      items: [
        { href: "/admin/zaposleni", permission: "manage_employees", label: "Zaposleni", icon: "bi-person-badge", feature: features.employees },
        { href: "/admin/eksperti", permission: "manage_employees", label: "Eksperti", icon: "bi-award" },
        { href: "/admin/korisnici", permission: "manage_users", label: "Korisnici", icon: "bi-people" },
      ],
    },
    {
      label: "Partnerski program", icon: "bi-diagram-3",
      items: [
        { href: "/admin/partneri", permission: "manage_partners", label: "Partneri", icon: "bi-person-vcard", feature: features.partners },
        // Isplate covers BOTH employee commission payouts and partner payouts
        // (see admin-ops.routes.js's payout-requests) - relevant whenever
        // either role can exist, not just when partners are on.
        { href: "/admin/isplate", permission: "manage_payouts", label: "Isplate", icon: "bi-cash-coin", feature: features.employees || features.partners },
      ],
    },
    {
      label: "Sadržaj i marketing", icon: "bi-newspaper",
      items: [
        { href: "/admin/blog", permission: "manage_blog", label: "Blog", icon: "bi-newspaper", feature: features.blog },
        { href: "/admin/kontakt", permission: "manage_marketing", label: "Kontakt", icon: "bi-envelope-paper" },
        { href: "/admin/tocak", permission: "manage_marketing", label: "Točak sreće", icon: "bi-stars" },
        { href: "/admin/newsletter", permission: "manage_marketing", label: "Newsletter", icon: "bi-send" },
        { href: "/admin/newsletter/kampanje", permission: "manage_marketing", label: "Kampanje", icon: "bi-megaphone" },
        { href: "/admin/testimoniali", permission: "manage_marketing", label: "Testimoniali", icon: "bi-star" },
        { href: "/admin/saradnici", permission: "manage_marketing", label: "Saradnici", icon: "bi-shop" },
        { href: "/admin/sajt", permission: "manage_site_content", label: "Podešavanja sajta", icon: "bi-sliders", exact: true },
        { href: "/admin/sajt/sadrzaj", permission: "manage_site_content", label: "Tekstovi sajta", icon: "bi-file-earmark-richtext" },
      ],
    },
    {
      label: "Poslovni izveštaji", icon: "bi-graph-up",
      items: [
        { href: "/admin/poslovni-izvestaji", permission: "view_business_reports", label: "Pregled", icon: "bi-graph-up" },
      ],
    },
    {
      label: "Sistem", icon: "bi-gear",
      items: [
        { href: "/admin/logovi", permission: "view_logs", label: "Logovi", icon: "bi-clipboard-data" },
        { href: "/admin/role", permission: "manage_roles", label: "Role", icon: "bi-shield-lock" },
      ],
    },
  ];
  // An item with no `feature` key is always shown (general/cross-module content -
  // roles, categories/tags, users, experts, newsletter, etc. - see docs/*/16).
  // A group that ends up with zero visible items (e.g. "Zakazivanje" when
  // booking is off) doesn't render its dropdown at all.
  // Items are also filtered by the viewer's permissions: a blog / services / shop manager only
  // gets the menu entries they can actually open (the routes enforce the same permission, this
  // just stops the menu from offering pages that answer 403).
  const adminPermissions = user?.permissions || [];
  const canSee = (item) => !item.permission || user?.roleName === "admin" || adminPermissions.includes(item.permission);
  adminNavGroups.forEach((group) => {
    group.items = group.items.filter((item) => (item.feature === undefined || item.feature) && canSee(item));
  });
  const visibleAdminNavGroups = adminNavGroups.filter((group) => group.items.length > 0);
  function isGroupActive(group) {
    return group.items.some(isItemActive);
  }
  // `exact` stavke (npr. /admin/sajt) ne smeju da budu aktivne i na podstranicama
  // koje imaju sopstvenu stavku (/admin/sajt/sadrzaj).
  function isItemActive(item) {
    return item.exact ? currentPath === item.href : currentPath.startsWith(item.href);
  }
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Uključi/isključi admin navigaciju">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="adminNav">
      <ul class="navbar-nav flex-wrap">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin"><i class="bi bi-speedometer2 me-1"></i>Početna</a></li>
        <% visibleAdminNavGroups.forEach(function(group) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle <%= isGroupActive(group) ? 'active' : '' %>" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi <%= group.icon %> me-1"></i><%= group.label %>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark">
              <% group.items.forEach(function(item) { %>
                <li><a class="dropdown-item <%= isItemActive(item) ? 'active' : '' %>" href="<%= item.href %>"><i class="bi <%= item.icon %> me-2"></i><%= item.label %></a></li>
              <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</nav>
<% } %>