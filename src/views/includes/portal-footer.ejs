<footer class="border-top py-3 mt-4 has-portal-bottom-nav">
  <div class="container text-center text-muted small mb-0">
    &copy; <%= new Date().getFullYear() %> Estetik Lab
  </div>
</footer>

<!-- Shared confirmation modal - used by every form with a data-confirm="..." attribute
     (delete buttons, cancel appointment, deactivate account, etc.) via main.js. This one
     IS load-bearing for the portals (e.g. _addresses-tab.ejs's "Ukloni" button uses it),
     unlike the marketing footer content above it in the full footer.ejs. -->
<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Potvrda</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
      </div>
      <div class="modal-body">
        <p id="confirmActionMessage" class="mb-0"></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Otkaži</button>
        <button type="button" class="btn btn-danger" id="confirmActionButton">Potvrdi</button>
      </div>
    </div>
  </div>
</div>

<%- include("./components/cookie-consent") %>

<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>"></script>
</body>
</html>