<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <% if (data.intro) { %>
    <!-- Landing intro: only shown on the plain, unfiltered /blog index -->
    <section class="bg-white border-bottom py-5">
      <div class="container">
        <%- include("../includes/breadcrumbs") %>

        <div class="row g-5 align-items-start">
          <div class="col-lg-7">
            <p class="section-eyebrow"><%= data.intro.eyebrow %></p>
            <h1 class="h2 mb-4"><%= data.intro.title %></h1>
            <p class="lead text-muted"><%= data.intro.lead %></p>
            <% data.intro.paragraphs.forEach(function(p) { %>
              <p class="text-muted mb-0"><%= p %></p>
            <% }) %>
          </div>

          <div class="col-lg-5">
            <div class="row g-4">
              <% data.intro.highlights.forEach(function(item) { %>
                <div class="col-6">
                  <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary-emphasis rounded-circle icon-circle-lg mb-3">
                    <i class="bi <%= item.icon %> fs-4"></i>
                  </div>
                  <h3 class="h6"><%= item.title %></h3>
                  <p class="text-muted small"><%= item.text %></p>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <div class="container <%= data.intro ? 'pt-4' : 'pt-5' %>">
    <% if (!data.intro) { %>
      <%- include("../includes/breadcrumbs") %>
      <h1 class="h3 mb-4">
        <% if (data.category) { %><%= data.category.naziv %>
        <% } else if (data.tag) { %>#<%= data.tag.naziv %>
        <% } else if (data.search) { %>Rezultati pretrage: "<%= data.search %>"
        <% } else { %>Blog<% } %>
      </h1>
    <% } %>
  </div>

  <% if (data.categoryTabs && data.categoryTabs.length > 0) { %>
    <nav class="service-filter-bar" aria-label="Filter po kategoriji">
      <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
        <div class="service-filter-scroll flex-grow-1">
          <% data.categoryTabs.forEach(function(tab) { %>
            <a href="<%= tab.href %>" class="filter-pill <%= tab.active ? 'active' : '' %>">
              <%= tab.label %>
              <span class="filter-pill-count">(<%= tab.count %>)</span>
            </a>
          <% }) %>
        </div>
        <form action="/blog/pretraga" method="GET" role="search" class="blog-search-form">
          <div class="input-group">
            <input type="search" name="q" class="form-control" placeholder="Pretraži blog..." value="<%= data.search || '' %>">
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
          </div>
        </form>
      </div>
    </nav>
  <% } %>

  <div class="container py-5">
    <% if (data.posts && data.posts.length > 0) { %>
      <div class="row g-4">
        <% data.posts.forEach(function(post) { %>
          <div class="col-md-4">
            <%- include("../includes/components/card-post", { post: post }) %>
          </div>
        <% }) %>
      </div>
      <%- include("../includes/pagination", { pagination: data.pagination }) %>
    <% } else { %>
      <p class="text-muted text-center py-5 mb-0">Nema postova za prikaz.</p>
    <% } %>

    <% if (data.tagChips && data.tagChips.length > 0) { %>
      <% const visibleChips = data.tagChips.slice(0, 14); %>
      <% const restChips = data.tagChips.slice(14); %>
      <div class="card mt-5">
        <div class="card-body p-4">
          <h2 class="h6 mb-3">Pretražite po temi</h2>
          <div class="d-flex flex-wrap gap-2">
            <% visibleChips.forEach(function(chip) { %>
              <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
            <% }) %>
          </div>
          <% if (restChips.length > 0) { %>
            <details class="tag-chips-more">
              <summary>Prikaži sve teme (<%= data.tagChips.length %>)</summary>
              <div class="d-flex flex-wrap gap-2 mt-3">
                <% restChips.forEach(function(chip) { %>
                  <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
                <% }) %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <section class="cta-section py-5 text-white text-center">
    <div class="container">
      <h2 class="h4 fw-bold mb-3">Spremni da zakažete tretman?</h2>
      <p class="mb-4">Pregledajte našu ponudu usluga i pronađite tretman koji odgovara vašim ciljevima.</p>
      <a href="/usluge" class="btn btn-light rounded-pill px-4 fw-semibold">Pogledajte usluge</a>
    </div>
  </section>
</main>

<%- include("../includes/footer") %>