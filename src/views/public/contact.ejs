<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <section class="bg-white py-5">
    <div class="container">
      <%- include("../includes/breadcrumbs") %>

      <p class="section-eyebrow"><%= data.intro.eyebrow %></p>
      <h1 class="h2 mb-4"><%= data.intro.title %></h1>
      <p class="lead text-muted mb-5"><%= data.intro.lead %></p>

      <% if (data.errors && data.errors.general) { %><div class="alert alert-danger"><%= data.errors.general %></div><% } %>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="card shadow-sm">
            <div class="card-body p-4">
              <form action="/kontakt" method="POST">
                <input type="hidden" name="CSRFToken" value="<%= data.csrfToken %>">
                <input type="hidden" name="arrivedWithTema" value="<%= data.formData.arrivedWithTema || '' %>">
                <input type="text" name="nickname" class="d-none" tabindex="-1" autocomplete="off">
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Ime</label>
                    <input type="text" name="firstName" class="form-control" value="<%= data.formData.firstName || '' %>" required>
                    <% if (data.errors && data.errors.firstName) { %><div class="text-danger small mt-1"><%= data.errors.firstName %></div><% } %>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Prezime</label>
                    <input type="text" name="lastName" class="form-control" value="<%= data.formData.lastName || '' %>" required>
                    <% if (data.errors && data.errors.lastName) { %><div class="text-danger small mt-1"><%= data.errors.lastName %></div><% } %>
                  </div>
                </div>
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control" value="<%= data.formData.email || '' %>" required>
                    <% if (data.errors && data.errors.email) { %><div class="text-danger small mt-1"><%= data.errors.email %></div><% } %>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Telefon</label>
                    <input type="text" name="phone" class="form-control" value="<%= data.formData.phone || '' %>">
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label">Tema</label>
                  <input type="text" name="topic" class="form-control" value="<%= data.formData.topic || '' %>">
                </div>
                <div class="mb-3">
                  <label class="form-label">Poruka</label>
                  <textarea name="message" class="form-control" rows="5" required><%= data.formData.message || '' %></textarea>
                  <% if (data.errors && data.errors.message) { %><div class="text-danger small mt-1"><%= data.errors.message %></div><% } %>
                </div>
                <div class="form-check mb-3">
                  <input type="checkbox" name="consent" value="true" class="form-check-input" id="consentCheck" required>
                  <label class="form-check-label small" for="consentCheck">Slažem se sa <a href="/politika-privatnosti">politikom privatnosti</a>.</label>
                  <% if (data.errors && data.errors.consent) { %><div class="text-danger small mt-1"><%= data.errors.consent %></div><% } %>
                </div>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Pošalji poruku</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card shadow-sm">
            <div class="card-body p-4">
              <h2 class="h5 mb-3">Kontakt podaci</h2>
              <ul class="list-unstyled mb-0">
                <li class="mb-3 d-flex align-items-start gap-2">
                  <i class="bi bi-geo-alt text-primary flex-shrink-0"></i>
                  <span><%= data.contact.address %></span>
                </li>
                <li class="mb-3 d-flex align-items-start gap-2">
                  <i class="bi bi-envelope text-primary flex-shrink-0"></i>
                  <a href="mailto:<%= data.contact.email %>" class="text-decoration-none"><%= data.contact.email %></a>
                </li>
                <li class="d-flex align-items-start gap-2">
                  <i class="bi bi-telephone text-primary flex-shrink-0"></i>
                  <a href="tel:<%= data.contact.phoneHref %>" class="text-decoration-none"><%= data.contact.phone %></a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location - same two-column pattern as the homepage -->
  <% if (data.map && data.map.embedUrl) { %>
    <section class="container py-5">
      <div class="row align-items-center g-5">
        <div class="col-lg-5">
          <p class="section-eyebrow">Gde se nalazimo</p>
          <h2 class="h3 mb-3"><%= data.map.address %></h2>
          <% if (data.googleDataNotice) { %>
            <p class="text-muted small mb-2"><%= data.googleDataNotice.text %></p>
            <a href="<%= data.googleDataNotice.privacyUrl %>" class="small fw-semibold">Pročitajte više u našoj Politici privatnosti</a>
          <% } %>
        </div>
        <div class="col-lg-7">
          <div class="ratio ratio-4x3 rounded-4 overflow-hidden border">
            <iframe
              src="<%= data.map.embedUrl %>"
              title="<%= data.map.address %>"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  <% } %>
</main>

<%- include("../includes/footer") %>