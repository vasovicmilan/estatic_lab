<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<header class="bg-light-subtle py-5 border-bottom">
  <div class="container">
    <div class="row justify-content-center text-center">
      <div class="col-lg-8">
        <p class="section-eyebrow">Partnerski program</p>
        <h1 class="display-5 fw-bold mb-3">Zarađujte deleći ono što volite</h1>
        <p class="lead text-muted"><%= data.intro %></p>
        <a href="/kontakt" class="btn btn-primary btn-lg rounded-pill px-4 mt-2">Postanite partner</a>
      </div>
    </div>
  </div>
</header>

<main>
  <%- include("../includes/flash-messages") %>

  <!-- Process - each step is a full card, deliberately roomy so a photo can be
       dropped in next to or above the text later (Milan: "detaljan ceo proces
       koji ću upariti sa slikama koje će vizuelno prikazati sve to") -->
  <section class="container py-5">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-7 text-center">
        <p class="section-eyebrow">Kako funkcioniše</p>
        <h2 class="h3 fw-bold">Od linka do isplate, u šest koraka</h2>
      </div>
    </div>

    <div class="row g-4">
      <% data.steps.forEach(function(step) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <!-- Placeholder image slot - swap the icon-circle below for an
                 <img> once real photos are ready -->
            <div class="card-body p-4">
              <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary-emphasis rounded-circle icon-circle-lg mb-3 fw-bold fs-4">
                <%= step.number %>
              </div>
              <h3 class="h5 fw-bold mb-2"><%= step.title %></h3>
              <p class="text-muted mb-0"><%- step.description %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <!-- Highlights -->
  <section class="bg-light-subtle py-5">
    <div class="container">
      <div class="row justify-content-center mb-4">
        <div class="col-lg-7 text-center">
          <p class="section-eyebrow">Zašto ovaj program</p>
          <h2 class="h3 fw-bold">Jednostavno i transparentno</h2>
        </div>
      </div>
      <div class="row g-4">
        <% data.highlights.forEach(function(text) { %>
          <div class="col-md-6">
            <div class="d-flex gap-3">
              <i class="bi bi-check-circle-fill text-primary fs-4 flex-shrink-0"></i>
              <p class="mb-0"><%- text %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="container py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-lg-7">
        <h2 class="h3 fw-bold mb-3">Spremni da počnete?</h2>
        <p class="text-muted mb-4">Javite nam se putem kontakt stranice - dogovorićemo vašu proviziju i otvoriti vam nalog.</p>
        <a href="/kontakt" class="btn btn-primary btn-lg rounded-pill px-4">Kontaktirajte nas</a>
      </div>
    </div>
  </section>
</main>

<%- include("../includes/footer") %>