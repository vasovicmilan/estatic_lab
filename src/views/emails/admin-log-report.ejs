<%
  function rows(items, emptyText) {
    if (!items || !items.length) return `<tr><td style="padding:12px 20px; color:#aca59d; font-size:13px;">${emptyText}</td></tr>`;
    return items.map(function(item) {
      return `<tr>
        <td style="padding:9px 20px; font-size:13px; color:#2d2a26; border-bottom:1px solid #ece7e2;">${item.label}</td>
        <td style="padding:9px 20px; font-size:13px; color:#2d2a26; border-bottom:1px solid #ece7e2; text-align:right;">${item.count}</td>
      </tr>`;
    }).join("");
  }
  function perfRows(items, emptyText) {
    if (!items || !items.length) return `<tr><td style="padding:12px 20px; color:#aca59d; font-size:13px;">${emptyText}</td></tr>`;
    return items.map(function(item) {
      return `<tr>
        <td style="padding:9px 20px; font-size:13px; color:#2d2a26; border-bottom:1px solid #ece7e2;">${item.label}</td>
        <td style="padding:9px 20px; font-size:13px; color:#2d2a26; border-bottom:1px solid #ece7e2; text-align:right;">${item.avgMs} ms</td>
        <td style="padding:9px 20px; font-size:13px; color:#aca59d; border-bottom:1px solid #ece7e2; text-align:right;">${item.count}x</td>
      </tr>`;
    }).join("");
  }
  function statBlock(label, value) {
    return `<td style="padding:16px 20px; font-size:14px; color:#2d2a26; width:50%;"><span style="display:block; font-size:12px; color:#9b9490; margin-bottom:2px;">${label}</span><strong style="font-size:16px;">${value}</strong></td>`;
  }

  // daysFound/startDate/endDate come from aggregateRange (log-report.service.js) - only
  // present for weekly/monthly/yearly reports, not the daily one (which is a single
  // LogSummary doc, not a range rollup) - hence the typeof guards, same pattern as
  // csrfToken elsewhere in this codebase: referencing a genuinely absent EJS local
  // throws, it doesn't just evaluate to undefined.
  //
  // If the daily-summary cron hasn't been running for the full period (a new
  // deployment, or a gap from downtime), daysFound will be less than the calendar
  // span, and every number in this report is a real, correctly-computed total for
  // however many days WERE tracked, not a bug. This note is what makes that visible
  // instead of a period with mostly/entirely zero data silently looking broken.
  const hasRangeInfo = typeof daysFound !== "undefined" && typeof startDate !== "undefined" && typeof endDate !== "undefined";
  const expectedDays = hasRangeInfo ? Math.round((new Date(endDate) - new Date(startDate)) / 86400000) + 1 : null;
  const incompleteDataNote = hasRangeInfo && daysFound < expectedDays
    ? `<p style="font-size:12px; color:#b3621a; background-color:#fdf3e7; border-radius:6px; padding:8px 12px; margin:0 0 20px;">Napomena: podaci dostupni za ${daysFound} od ${expectedDays} dana u ovom periodu (praćenje logova nije pokrivalo ceo period).</p>`
    : "";
%>
<%- include("_layout", {
  title: `${periodLabel} - izveštaj sa sajta`,
  eyebrow: "Admin · Izveštaj",
  heading: periodLabel,
  preheader: `${periodLabel} za period ${dateRangeLabel}`,
  body: `
    <p style="font-size:13px; color:#9b9490; margin:0 0 20px;">Period: ${dateRangeLabel}</p>
    ${incompleteDataNote}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf8f6; border-radius:8px; margin:0 0 24px;">
      <tr>
        ${statBlock("Ukupno zahteva", requests.total)}
        ${statBlock("Jedinstvenih IP", requests.uniqueIPs)}
      </tr>
      <tr>
        ${statBlock("2xx / 3xx", `${requests.byStatusClass["2xx"]} / ${requests.byStatusClass["3xx"]}`)}
        ${statBlock("4xx / 5xx", `${requests.byStatusClass["4xx"]} / ${requests.byStatusClass["5xx"]}`)}
      </tr>
      <tr>
        ${statBlock("Upozorenja", logs.warnCount)}
        ${statBlock("Greške", logs.errorCount)}
      </tr>
    </table>
    ${(typeof perf !== "undefined" && perf) ? `
    <h2 style="font-size:14px; color:#2d2a26; margin:0 0 10px; font-weight:700;">Performanse</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf8f6; border-radius:8px; margin:0 0 20px;">
      <tr>
        ${statBlock("Prosečno vreme odgovora", `${perf.avgResponseTimeMs} ms`)}
        ${statBlock("Najsporiji odgovor", `${perf.maxResponseTimeMs} ms${perf.maxResponseTimeUrl ? ` (${perf.maxResponseTimeUrl})` : ""}`)}
      </tr>
    </table>
    <h2 style="font-size:14px; color:#2d2a26; margin:0 0 10px; font-weight:700;">Najsporije rute (po proseku)</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px; border:1px solid #ece7e2; border-radius:8px; overflow:hidden;">
      ${perfRows(perf.slowestRoutes, "Nema dovoljno podataka za ovaj period.")}
    </table>
    ` : ""}
    <h2 style="font-size:14px; color:#2d2a26; margin:0 0 10px; font-weight:700;">Najčešće greške</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px; border:1px solid #ece7e2; border-radius:8px; overflow:hidden;">
      ${rows(topErrors, "Nema zabeleženih grešaka za ovaj period.")}
    </table>
    <h2 style="font-size:14px; color:#2d2a26; margin:0 0 10px; font-weight:700;">Najposećenije rute</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px; border:1px solid #ece7e2; border-radius:8px; overflow:hidden;">
      ${rows(topUrls, "Nema podataka o saobraćaju za ovaj period.")}
    </table>
    <h2 style="font-size:14px; color:#2d2a26; margin:0 0 10px; font-weight:700;">Rute sa najviše 4xx/5xx odgovora</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px; border:1px solid #ece7e2; border-radius:8px; overflow:hidden;">
      ${rows(topErrorUrls, "Nema neuspešnih zahteva za ovaj period.")}
    </table>
  `
}) %>