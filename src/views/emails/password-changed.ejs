<%
  // wasPasswordSetup: the account had no password before this (Google-only account,
  // or a guest account being claimed) - "password set" copy instead of "changed".
  const wasSet = typeof wasPasswordSetup !== 'undefined' && wasPasswordSetup;
  const heading = wasSet
    ? `Lozinka je podešena${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`
    : `Lozinka je promenjena${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`;
  const intro = wasSet
    ? "Ovo je potvrda da je lozinka za vaš nalog upravo podešena. Ubuduće možete da se prijavljujete i preko email adrese i lozinke."
    : "Ovo je potvrda da je lozinka za vaš nalog upravo promenjena.";
%>
<%- include("_layout", {
  title: heading,
  eyebrow: "Bezbednost",
  heading: heading,
  preheader: wasSet ? "Uspešno ste podesili lozinku za nalog" : "Vaša lozinka je uspešno promenjena",
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 8px;">${intro}</p>
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:16px 0 0;">
      Niste vi napravili ovu promenu? Odmah nas kontaktirajte na
      <a href="mailto:${SUPPORT_EMAIL}" style="color:#7a5c3e;">${SUPPORT_EMAIL}</a>.
    </p>
  `
}) %>