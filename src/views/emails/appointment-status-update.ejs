<% include("_helpers") %>
<%- include("_layout", {
  title: "Status termina ažuriran",
  eyebrow: "Termin",
  heading: `Status termina ažuriran${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`,
  preheader: `Vaš termin je ažuriran: ${status}`,
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 20px;">Novi status vašeg termina: ${badge(status, statusTone(status))}</p>
    ${infoTable(
      infoRow("Usluga", appointment.usluga?.naziv || "-") +
      infoRow("Termin", appointment.termin?.pocetak || "-") +
      (appointment.razlogOdbijanja ? infoRow("Razlog odbijanja", appointment.razlogOdbijanja) : "") +
      (appointment.razlogOtkazivanja ? infoRow("Razlog otkazivanja", appointment.razlogOtkazivanja) : "")
    )}
    <p style="font-size:13px; color:#9b9490; line-height:1.6; margin:0;">
      Pitanja? Pišite nam na <a href="mailto:${SUPPORT_EMAIL}" style="color:#7a5c3e;">${SUPPORT_EMAIL}</a>.
    </p>
  `
}) %>
