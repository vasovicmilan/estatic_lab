<% include("_helpers") %>
<%- include("_layout", {
  title: "Potvrdite porudžbinu",
  eyebrow: "Porudžbina",
  heading: `Potvrdite porudžbinu${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`,
  preheader: "Kliknite na link da potvrdite porudžbinu",
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 8px;">Hvala na porudžbini! Potvrdite je klikom na dugme ispod da je obradimo.</p>
    ${ctaButton(confirmUrl, "Potvrdi porudžbinu")}
    <p style="font-size:12px; color:#aca59d; line-height:1.6; margin:20px 0 0; text-align:center;">
      Link važi do: ${tokenExpiration}. Ako ne stignete da potvrdite, rezervisane zalihe se oslobađaju - javite nam se i pomoći ćemo da ipak završimo porudžbinu.
    </p>
    ${linkFallback(confirmUrl)}
  `
}) %>
