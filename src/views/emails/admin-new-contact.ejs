<% include("_helpers") %>
<%- include("_layout", {
  title: "Nova kontakt poruka",
  eyebrow: "Admin · Kontakt",
  heading: "Nova kontakt poruka",
  preheader: "Stigla je nova poruka sa kontakt forme",
  body: `
    ${infoTable(
      infoRow("Ime", `${contact.firstName || ""} ${contact.lastName || ""}`) +
      infoRow("Email", contact.email || "-")
    )}
    <p style="font-size:13px; color:#9b9490; margin:0 0 6px; text-transform:uppercase; letter-spacing:.04em; font-weight:700;">Poruka</p>
    <p style="font-size:14px; color:#2d2a26; line-height:1.6; margin:0 0 24px; padding:16px 20px; background-color:#faf8f6; border-radius:8px;">${contact.message || "-"}</p>
    ${ctaButton(adminUrl, "Pregledaj u admin panelu")}
  `
}) %>
