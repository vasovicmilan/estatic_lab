<%- include("_layout", {
  title: "Nova porudžbina",
  eyebrow: "Admin · Porudžbina",
  heading: "Nova porudžbina",
  preheader: "Nova porudžbina čeka obradu",
  body: `
    ${infoTable(
      infoRow("Klijent", order.korisnik?.ime || "-") +
      infoRow("Email", order.korisnik?.email || "-") +
      infoRow("Telefon", order.korisnik?.telefon || "-") +
      order.stavke.map(function(item) {
        return infoRow(`${item.naziv} (${item.varijanta})`, `&times; ${item.kolicina}`);
      }).join("") +
      infoRow("Ukupno", order.ukupnaCena) +
      infoRow("Status", badge(order.status, statusTone(order.status)))
    )}
    ${ctaButton(adminUrl, "Pregledaj u admin panelu")}
  `
}) %>