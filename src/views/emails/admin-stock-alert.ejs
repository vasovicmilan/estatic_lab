<% include("_helpers") %>
<%- include("_layout", {
  title: isOutOfStock ? "Proizvod je rasprodat" : "Proizvod na niskom stanju",
  eyebrow: "Admin · Zalihe",
  heading: isOutOfStock ? "Proizvod je rasprodat" : "Nisko stanje zaliha",
  preheader: `${productName} - ${variantLabel}`,
  body: `
    <p style="margin:0 0 20px;">${badge(isOutOfStock ? "Rasprodato" : "Nisko stanje", isOutOfStock ? "red" : "amber")}</p>
    ${infoTable(
      infoRow("Proizvod", productName) +
      infoRow("SKU", sku || "-") +
      infoRow("Varijanta", variantLabel) +
      infoRow("Preostalo na stanju", stock)
    )}
    ${ctaButton(adminUrl, "Ažuriraj zalihe")}
  `
}) %>
