<%- include("_layout", {
  title: "Porudžbina potvrđena",
  eyebrow: "Porudžbina",
  heading: `Porudžbina potvrđena${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}!`,
  preheader: "Vaša porudžbina je uspešno potvrđena",
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 20px;">Uskoro će biti obrađena - obavestićemo vas o promeni statusa.</p>
    ${infoTable(
      order.stavke.map(function(item) {
        return infoRow(`${item.naziv} (${item.varijanta}) &times; ${item.kolicina}`, `${item.ukupno} RSD`);
      }).join("") + infoRow("Ukupno", order.ukupnaCena)
    )}
    ${ctaButton(manageUrl, "Pregledaj moje porudžbine")}
  `
}) %>