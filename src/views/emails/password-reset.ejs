<%
  // isAccountClaim: guest booking auto-created this account. isPasswordSetup: a
  // Google-only account (no local password yet) used "forgot password". Both
  // reuse the exact same reset-token link/flow as a normal reset (see
  // email.service.js) - only the eyebrow/heading/copy differ, so all three read
  // as distinct, situation-appropriate emails.
  const isClaim = typeof isAccountClaim !== 'undefined' && isAccountClaim;
  const isSetup = typeof isPasswordSetup !== 'undefined' && isPasswordSetup;
  const eyebrow = (isClaim || isSetup) ? "Nalog" : "Bezbednost";
  const heading = (isClaim || isSetup)
    ? `Podesite lozinku za vaš nalog${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`
    : `Reset lozinke${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`;
  const intro = isClaim
    ? "Kreirali smo vam nalog kada ste zakazali termin kod nas, tako da možete da pratite i upravljate terminom online. Kliknite dugme ispod da postavite lozinku i preuzmete nalog."
    : isSetup
    ? "Vaš nalog je trenutno povezan samo sa Google prijavom i nema podešenu lozinku. Kliknite dugme ispod da je podesite - ubuduće ćete moći da se prijavljujete i preko email adrese i lozinke, pored Google prijave."
    : "Zatražili ste reset lozinke. Kliknite dugme ispod da postavite novu lozinku.";
  const buttonLabel = (isClaim || isSetup) ? "Podesi lozinku" : "Postavi novu lozinku";
  const footerNote = isClaim
    ? "Vaš termin ostaje zakazan bez obzira na to da li preuzmete nalog - ovo je samo opcioni korak da mu pristupite online."
    : isSetup
    ? "Ako niste vi zatražili ovo, slobodno zanemarite ovaj email - i dalje ćete moći da se prijavljujete preko Google-a, bez ikakvih promena na nalogu."
    : "Ako niste vi zatražili ovo, slobodno zanemarite ovaj email - vaša lozinka ostaje nepromenjena.";
%>
<%- include("_layout", {
  title: heading,
  eyebrow: eyebrow,
  heading: heading,
  preheader: intro,
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 8px;">${intro}</p>
    ${ctaButton(resetUrl, buttonLabel)}
    ${linkFallback(resetUrl)}
    <p style="font-size:12px; color:#aca59d; line-height:1.6; margin:20px 0 0;">${footerNote}</p>
  `
}) %>