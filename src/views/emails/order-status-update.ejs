<%- include("_layout", {
  title: "Status porudžbine ažuriran",
  eyebrow: "Porudžbina",
  heading: `Status porudžbine ažuriran${typeof firstName !== 'undefined' && firstName ? ', ' + firstName : ''}`,
  preheader: `Vaša porudžbina je ažurirana: ${status}`,
  body: `
    <p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 20px;">Novi status: ${badge(status, statusTone(status))}</p>
    ${order.razlogOtkazivanja ? `<p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 16px;"><strong>Razlog otkazivanja:</strong> ${order.razlogOtkazivanja}</p>` : ""}
    ${order.razlogVracanja ? `<p style="font-size:14px; color:#5b564f; line-height:1.6; margin:0 0 16px;"><strong>Razlog vraćanja:</strong> ${order.razlogVracanja}</p>` : ""}
    ${infoTable(
      order.stavke.map(function(item) {
        return infoRow(`${item.naziv} (${item.varijanta})`, `&times; ${item.kolicina}`);
      }).join("") + infoRow("Ukupno", order.ukupnaCena)
    )}
    <p style="font-size:13px; color:#9b9490; line-height:1.6; margin:0;">
      Pitanja? <a href="mailto:${SUPPORT_EMAIL}" style="color:#7a5c3e;">${SUPPORT_EMAIL}</a>.
    </p>
  `
}) %>