<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/moj-partner-nalog" }) %>

<main class="container py-4">
  <%- include("../includes/flash-messages") %>

  <h1 class="h3 mb-4">Moj partnerski nalog</h1>
  <%- include("../includes/components/partner-tabs") %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card h-100"><div class="card-body">
        <p class="text-muted small mb-1">Ukupno zarađeno</p>
        <p class="h4 mb-0 mono"><%= data.balance.earned %></p>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100"><div class="card-body">
        <p class="text-muted small mb-1">Isplaćeno</p>
        <p class="h4 mb-0 mono"><%= data.balance.paid %></p>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100"><div class="card-body">
        <p class="text-muted small mb-1">Rezervisano (na čekanju)</p>
        <p class="h4 mb-0 mono"><%= data.balance.reserved %></p>
      </div></div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100 border-primary"><div class="card-body">
        <p class="text-muted small mb-1">Raspoloživo za isplatu</p>
        <p class="h4 mb-0 text-primary mono"><%= data.balance.available %></p>
      </div></div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">Zatraži isplatu</div>
        <div class="card-body">
          <% if (data.balance.availableRaw <= 0) { %>
            <p class="text-muted mb-0">Trenutno nemate raspoloživ iznos za isplatu.</p>
          <% } else { %>
            <form action="/moj-partner-nalog/isplata" method="POST" class="d-flex flex-column flex-sm-row gap-2">
              <input type="hidden" name="CSRFToken" value="<%= csrfToken %>">
              <input type="number" name="amount" class="form-control" min="1" max="<%= data.balance.availableRaw %>" step="0.01" placeholder="Iznos" required>
              <button type="submit" class="btn btn-primary text-nowrap">Pošalji zahtev</button>
            </form>
            <small class="text-muted d-block mt-2">Najviše <%= data.balance.available %>.</small>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">Vaš referalni link</div>
        <div class="card-body">
          <% if (data.referralLinks.length === 0) { %>
            <p class="text-muted mb-2">Nemate aktivan referalni kod. Kontaktirajte administratora.</p>
          <% } else { %>
            <% data.referralLinks.forEach(function(ref) { %>
              <div class="mb-3">
                <p class="small text-muted mb-1"><%= ref.opis %></p>
                <div class="input-group">
                  <input type="text" class="form-control form-control-sm" value="<%= ref.link %>" readonly data-referral-link-input>
                  <button type="button" class="btn btn-outline-secondary btn-sm" data-copy-link-btn>Kopiraj</button>
                </div>
              </div>
            <% }) %>
          <% } %>
          <a href="/moj-partner-nalog/katalog" class="small">Pogledaj sve linkove po uslugama/proizvodima &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h6 mb-0">Moje isplate</h2>
      <a href="/moj-partner-nalog/isplate" class="small">Sve isplate &rarr;</a>
    </div>
    <% if (data.payoutRequests.length === 0) { %>
      <p class="text-muted mb-0">Još uvek niste podneli zahtev za isplatu.</p>
    <% } else { %>
      <div class="list-group d-lg-none">
        <% data.payoutRequests.forEach(function(p) { %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
              <div class="fs-6 fw-bold text-primary price-mono"><%= p.iznos %></div>
              <span class="badge bg-secondary"><%= p.status %></span>
            </div>
            <div class="text-muted small mono">Zatraženo: <%= p.zatrazeno %></div>
            <% if (p.napomena) { %><div class="small mt-1"><%= p.napomena %></div><% } %>
          </div>
        <% }) %>
      </div>
      <div class="card d-none d-lg-block">
        <div class="card-body p-0">
          <table class="table mb-0">
            <thead><tr><th>Iznos</th><th>Status</th><th>Zatraženo</th><th>Napomena</th></tr></thead>
            <tbody>
              <% data.payoutRequests.forEach(function(p) { %>
                <tr>
                  <td class="price-mono"><%= p.iznos %></td>
                  <td><%= p.status %></td>
                  <td class="mono"><%= p.zatrazeno %></td>
                  <td><%= p.napomena || "-" %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <div>
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h6 mb-0">Poslednje provizije</h2>
      <a href="/moj-partner-nalog/provizije" class="small">Sve provizije &rarr;</a>
    </div>
    <% if (data.recentCommissions.length === 0) { %>
      <p class="text-muted mb-0">Još uvek nemate zabeleženu proviziju.</p>
    <% } else { %>
      <div class="list-group d-lg-none">
        <% data.recentCommissions.forEach(function(c) { %>
          <div class="list-group-item">
            <div class="d-flex justify-content-between align-items-start">
              <div class="fw-semibold"><%= c.izvor %></div>
              <span class="badge bg-secondary"><%= c.status %></span>
            </div>
            <div class="fs-6 fw-bold text-primary price-mono"><%= c.iznos %></div>
            <div class="text-muted small mono"><%= c.osnovnaVrednost %> &middot; <%= c.procenat %></div>
          </div>
        <% }) %>
      </div>
      <div class="card d-none d-lg-block">
        <div class="card-body p-0">
          <table class="table mb-0">
            <thead><tr><th>Izvor</th><th>Osnovna vrednost</th><th>Procenat</th><th>Iznos</th><th>Status</th></tr></thead>
            <tbody>
              <% data.recentCommissions.forEach(function(c) { %>
                <tr>
                  <td><%= c.izvor %></td>
                  <td class="mono"><%= c.osnovnaVrednost %></td>
                  <td class="mono"><%= c.procenat %></td>
                  <td class="price-mono"><%= c.iznos %></td>
                  <td><%= c.status %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include("../includes/portal-footer") %>