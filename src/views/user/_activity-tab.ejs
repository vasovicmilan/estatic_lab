<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/nalog" }) %>

<main class="container py-4">
  <%- include("../includes/flash-messages") %>
  <h1 class="h3 mb-4">Moj nalog</h1>
  <%- include("../includes/components/user-tabs") %>

  <p class="text-muted small">Pregled vaših aktivnosti na sajtu (prijave, korpa, porudžbine, termini i izmene naloga). Lični podaci se ne prikazuju. Zapisi se čuvaju 12 meseci. Ako vidite prijavu koju niste napravili, promenite lozinku.</p>

  <% if (data.items && data.items.length > 0) { %>
    <div class="list-group">
      <% data.items.forEach(function(item) { %>
        <div class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <div class="fw-semibold"><%= item.opis %></div>
            <div class="text-muted small mono"><%= item.vreme %><% if (item.ip) { %> &middot; IP <%= item.ip %><% } %></div>
          </div>
          <% if (!item.uspesno) { %><span class="badge bg-danger">Neuspešno</span><% } %>
        </div>
      <% }) %>
    </div>
    <%- include("../includes/pagination", { pagination: data.pagination }) %>
  <% } else { %>
    <p class="text-muted">Još nema zabeleženih aktivnosti.</p>
  <% } %>
</main>

<%- include("../includes/portal-footer") %>
