<%- include("../includes/head") %>
<%- include("../includes/components/portal-header", { portalHome: "/nalog" }) %>

<main class="container py-4">
  <%- include("../includes/flash-messages") %>
  <%- include("../includes/components/user-tabs") %>
  <h1 class="h3 mb-1"><%= data.purchase.paket %></h1>
  <p class="mb-4"><span class="badge <%= data.purchase.isActive ? 'bg-success' : 'bg-secondary' %>"><%= data.purchase.status %></span></p>

  <% if (data.purchase.istekaUskoro) { %>
    <div class="alert alert-warning" role="alert">Paket ističe za <%= data.purchase.preostaloDana %> d (<%= data.purchase.istice %>), a imate još <%= data.purchase.preostalo %> slobodnih seansi. Zakažite na vreme.</div>
  <% } %>
  <% if (data.purchase.propaloSeansi > 0) { %>
    <div class="alert alert-secondary" role="alert">Neiskorišćene seanse: <%= data.purchase.propaloSeansi %>. Za dalje se javite salonu.</div>
  <% } %>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-header fw-semibold">Seanse po usluzi</div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead><tr><th>Usluga</th><th class="text-end">Ukupno</th><th class="text-end">Iskorišćeno</th><th class="text-end">Zakazano</th><th class="text-end">Slobodno</th></tr></thead>
            <tbody>
              <% data.purchase.stavke.forEach(function(s) { %>
                <tr>
                  <td><%= s.usluga %><% if (s.varijanta) { %> <span class="text-muted small">(<%= s.varijanta %>)</span><% } %></td>
                  <td class="text-end"><%= s.ukupnoSeansi %></td>
                  <td class="text-end"><%= s.iskorisceno %></td>
                  <td class="text-end"><%= s.rezervisano %></td>
                  <td class="text-end fw-semibold"><%= s.preostalo %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="card-footer small text-muted">„Zakazano“ su seanse za buduće termine koje su već rezervisane iz paketa; postaju „iskorišćene“ kad se termin završi. Otkažete li termin, seansa se vraća u paket.</div>
      </div>

      <div class="card">
        <div class="card-header fw-semibold">Termini iz ovog paketa</div>
        <% if (data.purchase.termini.length > 0) { %>
          <div class="list-group list-group-flush">
            <% data.purchase.termini.forEach(function(a) { %>
              <a href="/nalog/termini/detalji/<%= a.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold"><%= a.usluga %></div>
                  <div class="text-muted small mono"><%= a.datum %></div>
                </div>
                <span class="badge bg-secondary"><%= a.status %></span>
              </a>
            <% }) %>
          </div>
        <% } else { %>
          <div class="card-body text-muted">Još nema termina iz ovog paketa.</div>
        <% } %>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-6 text-muted">Kupljeno</dt><dd class="col-6 mono"><%= data.purchase.kupljeno %></dd>
            <dt class="col-6 text-muted">Ističe</dt><dd class="col-6 mono"><%= data.purchase.istice %></dd>
            <% if (data.purchase.popust) { %>
              <dt class="col-6 text-muted">Cena bez popusta</dt><dd class="col-6 price-mono"><%= data.purchase.originalnaCena %></dd>
              <dt class="col-6 text-muted">Popust</dt><dd class="col-6 price-mono"><%= data.purchase.popust %></dd>
            <% } %>
            <dt class="col-6 text-muted">Plaćeno</dt><dd class="col-6 price-mono"><%= data.purchase.placeno %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3 d-flex gap-2">
    <a href="<%= data.backUrl %>" class="btn btn-outline-secondary">Nazad</a>
    <% if (data.purchase.isActive && data.purchase.preostalo > 0) { %><a href="<%= data.bookUrl %>" class="btn btn-primary">Zakaži termin</a><% } %>
  </div>
</main>

<%- include("../includes/portal-footer") %>
