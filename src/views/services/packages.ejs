<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <section class="bg-white py-5">
    <div class="container">
      <%- include("../includes/breadcrumbs") %>

      <% if (data.intro) { %>
        <div class="row g-5 align-items-start">
          <div class="col-lg-7">
            <p class="section-eyebrow"><%= data.intro.eyebrow %></p>
            <h1 class="h2 mb-4"><%= data.intro.title %></h1>
            <p class="lead text-muted"><%= data.intro.lead %></p>
            <% data.intro.paragraphs.forEach(function(p) { %>
              <p class="text-muted mb-0"><%= p %></p>
            <% }) %>
          </div>
          <div class="col-lg-5">
            <div class="row g-4">
              <% data.intro.highlights.forEach(function(item) { %>
                <div class="col-6">
                  <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary-emphasis rounded-circle icon-circle-lg mb-3">
                    <i class="bi <%= item.icon %> fs-4"></i>
                  </div>
                  <h2 class="h6"><%= item.title %></h2>
                  <p class="text-muted small"><%= item.text %></p>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% } else { %>
        <h1 class="h3 mb-2 text-center">Paketi</h1>
        <% if (data.subtitle) { %><p class="text-muted text-center mb-4"><%= data.subtitle %></p><% } %>
      <% } %>
    </div>
  </section>

  <%- include("../includes/components/ritual-divider") %>

  <div class="container py-5">
    <% if (data.packageGroups && data.packageGroups.length > 0) { %>
      <div class="row g-4">
        <% data.packageGroups.forEach(function(group) { %>
          <div class="col-md-4">
            <%- include("../includes/components/card-package-group", { group: group }) %>
          </div>
        <% }) %>
      </div>
      <%- include("../includes/pagination", { pagination: data.pagination }) %>
    <% } else { %>
      <p class="text-center text-muted">Trenutno nema dostupnih paketa.</p>
    <% } %>
  </div>

  <% if (data.intro) { %>
    <section class="cta-section py-5 text-white text-center">
      <div class="container">
        <h2 class="h4 fw-bold mb-3">Niste sigurni koji paket da izaberete?</h2>
        <p class="mb-4">Kontaktirajte nas i predložićemo paket koji najbolje odgovara vašim ciljevima.</p>
        <a href="/kontakt" class="btn btn-light rounded-pill px-4 fw-semibold">Kontaktirajte nas</a>
      </div>
    </section>
  <% } %>
</main>

<%- include("../includes/footer") %>