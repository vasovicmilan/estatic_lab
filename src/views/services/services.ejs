<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main>
  <%- include("../includes/flash-messages") %>

  <section class="bg-white pt-5 <%= data.intro ? '' : 'pb-4' %>">
    <div class="container">
      <%- include("../includes/breadcrumbs") %>

      <% if (data.intro) { %>
        <div class="row g-5 align-items-end">
          <div class="col-lg-7">
            <p class="section-eyebrow"><%= data.intro.eyebrow %></p>
            <h1 class="h2 mb-4"><%= data.intro.title %></h1>
            <p class="lead text-muted"><%= data.intro.lead %></p>
            <% data.intro.paragraphs.forEach(function(p) { %>
              <p class="text-muted mb-0"><%= p %></p>
            <% }) %>
          </div>
          <div class="col-lg-5">
            <div class="d-flex gap-5">
              <% data.stats.forEach(function(stat) { %>
                <div>
                  <div class="service-stat-value"><%= stat.value %></div>
                  <div class="small text-muted"><%= stat.label %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="row g-4 mt-1 mb-4">
          <% data.intro.highlights.forEach(function(item) { %>
            <div class="col-6 col-md-3">
              <div class="d-flex align-items-center justify-content-center bg-primary-subtle text-primary-emphasis rounded-circle icon-circle-lg mb-3">
                <i class="bi <%= item.icon %> fs-4"></i>
              </div>
              <h2 class="h6"><%= item.title %></h2>
              <p class="text-muted small"><%= item.text %></p>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <h1 class="h3 mb-2"><%= data.category ? data.category.naziv : (data.tag ? data.tag.naziv : "Usluge") %></h1>
        <% if (data.subtitle) { %><p class="text-muted mb-2"><%= data.subtitle %></p><% } %>
        <% const catOrTagDesc = (data.category && data.category.description) || (data.tag && data.tag.description); %>
        <% if (catOrTagDesc) { %><p class="mb-4"><%= catOrTagDesc %></p><% } %>
      <% } %>
    </div>
  </section>

  <%- include("../includes/components/ritual-divider") %>

  <% if (data.categoryTabRows && data.categoryTabRows.length > 0) { %>
    <nav class="service-filter-bar" aria-label="Filter po kategoriji">
      <div class="container d-flex flex-column gap-2 py-3">
        <% data.categoryTabRows.forEach(function(row, rowIndex) { %>
          <div class="service-filter-scroll <%= rowIndex > 0 ? 'ps-3 border-start' : '' %>">
            <% row.forEach(function(tab) { %>
              <a href="<%= tab.href %>" class="filter-pill <%= rowIndex > 0 ? 'filter-pill-sub' : '' %> <%= tab.active ? 'active' : '' %>">
                <%= tab.label %>
                <span class="filter-pill-count">(<%= tab.count %>)</span>
              </a>
            <% }) %>
          </div>
        <% }) %>
      </div>
    </nav>
  <% } %>

  <div class="container py-5">
    <% if (data.services && data.services.length > 0) { %>
      <div class="row g-4">
        <% data.services.forEach(function(service) { %>
          <div class="col-md-4">
            <%- include("../includes/components/card-service", { service: service }) %>
          </div>
        <% }) %>
      </div>
      <%- include("../includes/pagination", { pagination: data.pagination }) %>
    <% } else { %>
      <p class="text-muted text-center py-5 mb-0">Nema tretmana u ovoj kategoriji.</p>
    <% } %>

    <% if (data.tagChips && data.tagChips.length > 0) { %>
      <% const visibleChips = data.tagChips.slice(0, 14); %>
      <% const restChips = data.tagChips.slice(14); %>
      <div class="card mt-5">
        <div class="card-body p-4">
          <h2 class="h6 mb-3">Pretražite po temi</h2>
          <div class="d-flex flex-wrap gap-2">
            <% visibleChips.forEach(function(chip) { %>
              <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
            <% }) %>
          </div>
          <% if (restChips.length > 0) { %>
            <details class="tag-chips-more">
              <summary>Prikaži sve teme (<%= data.tagChips.length %>)</summary>
              <div class="d-flex flex-wrap gap-2 mt-3">
                <% restChips.forEach(function(chip) { %>
                  <a href="<%= chip.href %>" class="tag-chip <%= chip.active ? 'active' : '' %>"><%= chip.label %></a>
                <% }) %>
              </div>
            </details>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <% if (data.category && data.category.contentBlocks && data.category.contentBlocks.length > 0) { %>
    <section class="bg-white border-top py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-9 category-landing-content">
            <%- include("../includes/components/content-blocks-render", { blocks: data.category.contentBlocks }) %>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <% if (data.intro) { %>
    <section class="cta-section py-5 text-white text-center">
      <div class="container">
        <h2 class="h4 fw-bold mb-3">Niste sigurni koji tretman vam odgovara?</h2>
        <p class="mb-4">Zakažite besplatnu konsultaciju i naš tim će vam predložiti pravo rešenje.</p>
        <a href="/kontakt" class="btn btn-light rounded-pill px-4 fw-semibold">Zakažite besplatnu konsultaciju</a>
      </div>
    </section>
  <% } %>
</main>

<%- include("../includes/footer") %>