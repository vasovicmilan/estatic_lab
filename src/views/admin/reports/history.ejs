<%- include("../../includes/head") %>
<%- include("../../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../../includes/breadcrumbs") %>
  <%- include("../../includes/flash-messages") %>

  <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-4">
    <h1 class="h3 mb-0"><%= data.periodLabel %> izveštaji - istorija</h1>
    <a href="<%= data.dashboardUrl %>" class="btn btn-outline-secondary btn-sm">&larr; Nazad na pregled</a>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <% if (data.items.length === 0) { %>
        <p class="text-muted p-3 mb-0">Nema sačuvanih izveštaja za ovaj tip perioda još uvek.</p>
      <% } else { %>
        <div class="table-responsive">
        <table class="table mb-0">
          <thead>
            <tr>
              <% data.columns.forEach(function(col) { %>
                <%- include("../../includes/components/sortable-th", { col: col, sort: data.sort, basePath: data.pagination.basePath, query: data.pagination.query }) %>
              <% }) %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% data.items.forEach(function(item) { %>
              <tr>
                <% data.columns.forEach(function(col) { %>
                  <td><%= col.key === 'period' ? item.periodKey : item[col.key] %></td>
                <% }) %>
                <td><a href="<%= item.detailUrl %>" class="btn btn-sm btn-outline-secondary">Detalji</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      <% } %>
    </div>
  </div>

  <%- include("../../includes/pagination", { pagination: data.pagination }) %>
</main>

<%- include("../../includes/footer") %>
