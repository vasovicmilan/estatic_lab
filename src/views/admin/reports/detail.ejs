<%- include("../../includes/head") %>
<%- include("../../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../../includes/breadcrumbs") %>
  <%- include("../../includes/flash-messages") %>

  <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-4">
    <h1 class="h3 mb-0"><%= data.summary.periodLabel %> izveštaj - <%= data.summary.periodKey %></h1>
    <div class="d-flex gap-2 flex-wrap">
      <a href="/admin/poslovni-izvestaji/istorija/<%= data.summary.periodType %>/<%= data.summary.periodKey %>/pdf" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-file-earmark-pdf"></i> Preuzmi PDF
      </a>
      <a href="<%= data.backUrl %>" class="btn btn-outline-secondary btn-sm">&larr; Nazad na istoriju</a>
    </div>
  </div>

  <% if (!data.summary) { %>
    <div class="alert alert-warning">Nema podataka za prikaz.</div>
  <% } else { %>

    <h2 class="h6 text-uppercase text-muted mb-3">Zakazivanja</h2>
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Ukupno termina</p>
          <p class="h4 mb-0"><%= data.summary.appointments.total %></p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Prihod</p>
          <p class="h4 mb-0"><%= data.summary.appointments.revenue %></p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Stopa ne-pojavljivanja</p>
          <p class="h4 mb-0"><%= data.summary.appointments.noShowRate %>%</p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Po statusu</p>
          <p class="small mb-0">
            <% (data.summary.appointments.byStatus || []).forEach(function(s) { %>
              <%= s.label %>: <%= s.count %><br>
            <% }) %>
          </p>
        </div></div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-header">Po usluzi</div>
          <div class="card-body p-0">
            <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr><th>Usluga</th><th class="text-end">Termina</th><th class="text-end">Prihod</th></tr></thead>
              <tbody>
                <% if (!data.summary.appointments.byService.length) { %>
                  <tr><td colspan="3" class="text-muted small">Nema podataka.</td></tr>
                <% } %>
                <% data.summary.appointments.byService.forEach(function(row) { %>
                  <tr><td><%= row.label %></td><td class="text-end"><%= row.count %></td><td class="text-end"><%= row.value %></td></tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card h-100">
          <div class="card-header">Po terapeutu</div>
          <div class="card-body p-0">
            <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr><th>Terapeut</th><th class="text-end">Termina</th><th class="text-end">Prihod</th></tr></thead>
              <tbody>
                <% if (!data.summary.appointments.byEmployee.length) { %>
                  <tr><td colspan="3" class="text-muted small">Nema podataka.</td></tr>
                <% } %>
                <% data.summary.appointments.byEmployee.forEach(function(row) { %>
                  <tr><td><%= row.label %></td><td class="text-end"><%= row.count %></td><td class="text-end"><%= row.value %></td></tr>
                <% }) %>
              </tbody>
            </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mb-3">Prodavnica</h2>
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Ukupno porudžbina</p>
          <p class="h4 mb-0"><%= data.summary.orders.total %></p>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Prihod</p>
          <p class="h4 mb-0"><%= data.summary.orders.revenue %></p>
        </div></div>
      </div>
      <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Prosečna vrednost porudžbine</p>
          <p class="h4 mb-0"><%= data.summary.orders.avgOrderValue %></p>
        </div></div>
      </div>
    </div>
    <div class="card mb-4">
      <div class="card-header">Najprodavaniji proizvodi</div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Proizvod</th><th class="text-end">Komada</th><th class="text-end">Prihod</th></tr></thead>
          <tbody>
            <% if (!data.summary.orders.byProduct.length) { %>
              <tr><td colspan="3" class="text-muted small">Nema podataka.</td></tr>
            <% } %>
            <% data.summary.orders.byProduct.forEach(function(row) { %>
              <tr><td><%= row.label %></td><td class="text-end"><%= row.count %></td><td class="text-end"><%= row.value %></td></tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mb-3">Paketi</h2>
    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Prodato paketa</p>
          <p class="h4 mb-0"><%= data.summary.packages.totalPurchased %></p>
        </div></div>
      </div>
      <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Prihod</p>
          <p class="h4 mb-0"><%= data.summary.packages.revenue %></p>
        </div></div>
      </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mb-3">Provizije</h2>
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Zaposleni - zarađeno</p>
          <p class="h5 mb-0"><%= data.summary.commissions.employeeEarned %></p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Zaposleni - isplaćeno</p>
          <p class="h5 mb-0"><%= data.summary.commissions.employeePaid %></p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Partneri - zarađeno</p>
          <p class="h5 mb-0"><%= data.summary.commissions.partnerEarned %></p>
        </div></div>
      </div>
      <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Partneri - isplaćeno</p>
          <p class="h5 mb-0"><%= data.summary.commissions.partnerPaid %></p>
        </div></div>
      </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mb-3">Kuponi</h2>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Ukupno iskorišćeno</p>
          <p class="h4 mb-0"><%= data.summary.coupons.totalRedemptions %></p>
        </div></div>
      </div>
      <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
          <p class="text-muted small mb-1">Ukupan dat popust</p>
          <p class="h4 mb-0"><%= data.summary.coupons.totalDiscountGiven %></p>
        </div></div>
      </div>
    </div>
    <div class="card mb-4">
      <div class="card-header">Po kuponu</div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm mb-0">
          <thead><tr><th>Kod</th><th class="text-end">Iskorišćeno</th><th class="text-end">Dat popust</th></tr></thead>
          <tbody>
            <% if (!data.summary.coupons.byCoupon.length) { %>
              <tr><td colspan="3" class="text-muted small">Nijedan kupon nije iskorišćen u ovom periodu.</td></tr>
            <% } %>
            <% data.summary.coupons.byCoupon.forEach(function(row) { %>
              <tr><td><%= row.label %></td><td class="text-end"><%= row.count %></td><td class="text-end"><%= row.value %></td></tr>
            <% }) %>
          </tbody>
        </table>
        </div>
      </div>
    </div>

  <% } %>
</main>

<%- include("../../includes/footer") %>
