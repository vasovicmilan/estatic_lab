<%- include("../../includes/head") %>
<%- include("../../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../../includes/breadcrumbs") %>
  <%- include("../../includes/flash-messages") %>

  <h1 class="h3 mb-1">Poslovni izveštaji</h1>
  <p class="text-muted small mb-4">Trenutni (tekući, još nezavršen) period za svaki tip izveštaja - uživo, izračunato u trenutku učitavanja stranice. Za prethodne, kompletirane periode pogledaj istoriju.</p>

  <div class="row g-4">
    <% data.periods.forEach(function(period) { %>
      <div class="col-md-6 col-xl-4">
        <div class="card h-100">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span><%= period.label %></span>
            <a href="<%= period.historyUrl %>" class="btn btn-sm btn-outline-secondary">Istorija</a>
          </div>
          <div class="card-body">
            <% if (!period.summary) { %>
              <p class="text-muted small mb-0">Još nije generisan izveštaj za tekući period.</p>
            <% } else { %>
              <div class="d-flex align-items-center gap-2 mb-2">
                <p class="text-muted small mono mb-0"><%= period.summary.periodKey %></p>
                <% if (period.summary.isLive) { %><span class="badge bg-success-subtle text-success-emphasis">Uživo</span><% } %>
              </div>
              <div class="row g-2 small">
                <div class="col-6">
                  <span class="text-muted d-block">Termina</span>
                  <strong class="mono"><%= period.summary.appointments.total %></strong>
                </div>
                <div class="col-6">
                  <span class="text-muted d-block">Prihod termina</span>
                  <strong class="price-mono"><%= period.summary.appointments.revenue %></strong>
                </div>
                <div class="col-6">
                  <span class="text-muted d-block">Porudžbina</span>
                  <strong class="mono"><%= period.summary.orders.total %></strong>
                </div>
                <div class="col-6">
                  <span class="text-muted d-block">Prihod prodavnice</span>
                  <strong class="price-mono"><%= period.summary.orders.revenue %></strong>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<%- include("../../includes/footer") %>
