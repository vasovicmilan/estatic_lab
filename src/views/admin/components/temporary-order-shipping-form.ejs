<form action="/admin/privremene-porudzbine/<%= data.orderId %>/dostava" method="POST" data-confirm="Sačuvati ovu cenu dostave? Kupcu će odmah biti poslat email sa konačnom cenom i linkom za potvrdu porudžbine.">
  <input type="hidden" name="_method" value="PUT">
  <input type="hidden" name="CSRFToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <p class="small text-muted mb-2">
    Porudžbina sadrži artikal koji se ne šalje redovnom poštom (veliki/teški uređaj) - unesite stvarnu cenu dostave. Kupac do sada NIJE dobio link za potvrdu (samo obaveštenje da čekamo procenu) - čim sačuvate cenu, dobiće email sa konačnim iznosom i radnim linkom.
  </p>
  <div class="input-group input-group-sm">
    <input type="number" name="shippingAmount" class="form-control" min="0" step="0.01" placeholder="Cena dostave u <%= currencySymbol %>" required>
    <button type="submit" class="btn btn-warning">Sačuvaj cenu dostave</button>
  </div>
</form>