<form action="/admin/privremene-porudzbine/<%= data.orderId %>/dostava" method="POST" data-confirm="Sačuvati ovu cenu dostave? Kupac će nakon ovoga moći sam da potvrdi porudžbinu.">
  <input type="hidden" name="_method" value="PUT">
  <input type="hidden" name="CSRFToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <p class="small text-muted mb-2">
    Porudžbina sadrži artikal koji se ne šalje redovnom poštom (veliki/teški uređaj) - unesite stvarnu cenu dostave da bi kupac mogao sam da potvrdi porudžbinu.
  </p>
  <div class="input-group input-group-sm">
    <input type="number" name="shippingAmount" class="form-control" min="0" step="0.01" placeholder="Cena dostave u RSD" required>
    <button type="submit" class="btn btn-warning">Sačuvaj cenu dostave</button>
  </div>
</form>