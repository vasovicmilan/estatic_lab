<form action="<%= data.actionUrl %>" method="POST">
  <input type="hidden" name="_method" value="PUT">
  <input type="hidden" name="CSRFToken" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <label class="form-label small text-muted" for="rescheduleNewStartTime">Novo vreme</label>
  <input type="datetime-local" name="newStartTime" id="rescheduleNewStartTime" class="form-control form-control-sm mb-2" required>
  <button type="submit" class="btn btn-outline-primary btn-sm w-100">Pomeri termin</button>
</form>