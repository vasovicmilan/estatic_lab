<%- include("../includes/head") %>
<%- include("../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../includes/breadcrumbs") %>
  <%- include("../includes/flash-messages") %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><%= pageTitle %></h1>
    <div class="d-flex gap-2">
      <% if (data.editUrl) { %>
        <a href="<%= data.editUrl %>" class="btn btn-warning btn-sm"><i class="bi bi-pencil"></i> Izmeni</a>
      <% } %>
      <% if (data.galleryUrl) { %>
        <a href="<%= data.galleryUrl %>" class="btn btn-outline-primary btn-sm"><i class="bi bi-images"></i> Galerija i video</a>
      <% } %>
      <% if (data.backUrl) { %>
        <a href="<%= data.backUrl %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Nazad</a>
      <% } %>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-8">
      <% (data.sections || []).forEach(function(section) { %>
        <div class="card mb-4">
          <div class="card-header"><h2 class="h6 card-title mb-0"><%= section.title %></h2></div>
          <div class="card-body">
            <% if (section.type === 'table') { %>
              <dl class="row mb-0">
                <% section.rows.forEach(function(row) { %>
                  <dt class="col-sm-4 text-muted"><%= row.label %></dt>
                  <dd class="col-sm-8"><%- row.value %></dd>
                <% }) %>
              </dl>
            <% } else if (section.type === 'list') { %>
              <% if (section.items.length === 0) { %>
                <p class="text-muted mb-0">Nema stavki.</p>
              <% } else { %>
                <ul class="mb-0">
                  <% section.items.forEach(function(item) { %><li><%= item %></li><% }) %>
                </ul>
              <% } %>
            <% } else if (section.type === 'blocks') { %>
              <% (section.blocks || []).forEach(function(block) { %>
                <% if (block.tip === 'heading') { %>
                  <h4><%= block.tekst %></h4>
                <% } else if (block.tip === 'paragraph') { %>
                  <p><%= block.tekst %></p>
                <% } else if (block.tip === 'image' && block.slika) { %>
                  <img src="<%= block.slika.url %>" alt="<%= block.slika.alt %>" class="img-fluid rounded mb-3">
                <% } else if (block.tip === 'quote') { %>
                  <blockquote class="blockquote"><p><%= block.tekst %></p><% if (block.izvor) { %><footer class="blockquote-footer"><%= block.izvor %></footer><% } %></blockquote>
                <% } else if (block.tip === 'list') { %>
                  <% if (block.uredjeno) { %>
                    <ol><% (block.stavke || []).forEach(function(s) { %><li><%= s %></li><% }) %></ol>
                  <% } else { %>
                    <ul><% (block.stavke || []).forEach(function(s) { %><li><%= s %></li><% }) %></ul>
                  <% } %>
                <% } else if (block.tip === 'video' && block.video) { %>
                  <video controls class="w-100 rounded mb-3" src="<%= block.video.url %>"></video>
                <% } else if (block.tip === 'table' && block.kolone && block.kolone.length > 0) { %>
                  <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle">
                      <thead>
                        <tr>
                          <th></th>
                          <% block.kolone.forEach(function(col) { %><th><%= col %></th><% }) %>
                        </tr>
                      </thead>
                      <tbody>
                        <% (block.redovi || []).forEach(function(row) { %>
                          <tr>
                            <th scope="row"><%= row.label %></th>
                            <% (row.values || []).forEach(function(val) { %><td><%= val %></td><% }) %>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } else if (block.tip === 'cards' && block.kartice && block.kartice.length > 0) { %>
                  <div class="row g-3 mb-3">
                    <% block.kartice.forEach(function(card) { %>
                      <div class="col-12 col-md-6">
                        <div class="card h-100">
                          <div class="card-body">
                            <% if (card.icon) { %><i class="<%= card.icon %> fs-3 text-primary mb-2 d-block"></i><% } %>
                            <% if (card.title) { %><h5 class="card-title"><%= card.title %></h5><% } %>
                            <% if (card.text) { %><p class="card-text"><%= card.text %></p><% } %>
                          </div>
                        </div>
                      </div>
                    <% }) %>
                  </div>
                <% } else if (block.tip === 'gallery' && block.galerija && block.galerija.length > 0) { %>
                  <div class="row g-2 mb-3">
                    <% block.galerija.forEach(function(img) { %>
                      <div class="col-4 col-md-3">
                        <img src="<%= img.url %>" alt="<%= img.alt || '' %>" class="img-fluid rounded">
                      </div>
                    <% }) %>
                  </div>
                <% } else if (block.tip === 'callout') { %>
                  <div class="alert alert-<%= block.varijanta %> mb-3">
                    <% if (block.naslovBloka) { %><h5 class="alert-heading"><%= block.naslovBloka %></h5><% } %>
                    <p class="mb-0"><%= block.tekst %></p>
                  </div>
                <% } else if (block.tip === 'faq' && block.faqStavke && block.faqStavke.length > 0) { %>
                  <div class="mb-3">
                    <% if (block.naslovBloka) { %><h5><%= block.naslovBloka %></h5><% } %>
                    <% block.faqStavke.forEach(function(item) { %>
                      <details class="mb-2">
                        <summary class="fw-semibold"><%= item.question %></summary>
                        <p class="mt-2 mb-0"><%= item.answer %></p>
                      </details>
                    <% }) %>
                  </div>
                <% } else if (block.tip === 'cta') { %>
                  <div class="card bg-light border-0 p-4 mb-3 text-center">
                    <% if (block.naslovBloka) { %><h5><%= block.naslovBloka %></h5><% } %>
                    <% if (block.tekst) { %><p><%= block.tekst %></p><% } %>
                    <% if (block.dugme && block.dugme.url) { %>
                      <a href="<%= block.dugme.url %>" class="btn btn-primary mx-auto" style="width: fit-content;"><%= block.dugme.tekst || 'Zakažite termin' %></a>
                    <% } %>
                  </div>
                <% } else if (block.tip === 'serviceReference') { %>
                  <div class="card border-primary p-3 mb-3">
                    <% if (block.naslovBloka) { %><h6 class="mb-1"><%= block.naslovBloka %></h6><% } %>
                    <% if (block.tekst) { %><p class="small mb-2"><%= block.tekst %></p><% } %>
                    <% if (block.dugme && block.dugme.url) { %>
                      <a href="<%= block.dugme.url %>" class="small"><%= block.dugme.tekst || 'Pogledajte uslugu' %> &rarr;</a>
                    <% } %>
                  </div>
                <% } else if (block.tip === 'divider') { %>
                  <hr class="my-4">
                <% } %>
              <% }) %>
              <% } else if (section.type === 'variants') { %>
              <% if (!section.variants || section.variants.length === 0) { %>
                <p class="text-muted mb-0">Nema varijanti.</p>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Naziv</th>
                        <th>Trajanje</th>
                        <th>Cena</th>
                        <th>Najbolji izbor</th>
                        <th>Aktivan</th>
                      </tr>
                    </thead>
                    <tbody>
                     <% section.variants.forEach(function(v) { %>
                        <tr>
                          <td>
                            <%= v.naziv %>
                            <% if (v.oznaka) { %><span class="badge text-bg-light border ms-1"><%= v.oznaka %></span><% } %>
                          </td>
                          <td><%= v.trajanje %> min</td>
                          <td>
                            <%= v.cena %> RSD
                            <% if (v.staraCena) { %><span class="text-muted text-decoration-line-through ms-1 small"><%= v.staraCena %> RSD</span><% } %>
                          </td>
                          <td><%= v.najbolji ? "Da" : "Ne" %></td>
                          <td><%= v.aktivan ? "Da" : "Ne" %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
           <% } else if (section.type === 'custom') { %>
              <% if (typeof section.data !== 'undefined') { %>
                <%- include("components/" + section.content, { data: section.data }) %>
              <% } else { %>
                <%- section.content %>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="col-lg-4">
      <% (data.sidebar || []).forEach(function(section) { %>
        <div class="card mb-4">
          <div class="card-header"><h2 class="h6 card-title mb-0"><%= section.title %></h2></div>
          <div class="card-body">
            <% if (section.type === 'table') { %>
              <dl class="row mb-0">
                <% section.rows.forEach(function(row) { %>
                  <dt class="col-sm-5 text-muted small"><%= row.label %></dt>
                  <dd class="col-sm-7 small"><%- row.value %></dd>
                <% }) %>
              </dl>
            <% } else if (section.type === 'custom') { %>
              <% if (typeof section.data !== 'undefined') { %>
                <%- include("components/" + section.content, { data: section.data }) %>
              <% } else { %>
                <%- section.content %>
              <% } %>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<%- include("../includes/footer") %>