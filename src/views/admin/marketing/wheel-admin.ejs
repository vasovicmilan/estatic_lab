<%- include("../../includes/head") %>
<%- include("../../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../../includes/breadcrumbs") %>
  <%- include("../../includes/flash-messages") %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Točak sreće: nagrade i QR</h1>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/tocak" class="btn btn-outline-secondary btn-sm"><i class="bi bi-people"></i> Kontakti</a>
      <a href="/admin/tocak/kuponi" class="btn btn-outline-secondary btn-sm"><i class="bi bi-ticket-perforated"></i> Kuponi</a>
      <a href="/admin/tocak/izvoz.csv" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i> Izvoz svih kontakata (CSV)</a>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span class="fw-semibold">Nagrade</span>
      <a href="/admin/tocak/nagrade/nova" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Dodaj nagradu</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Nagrada</th>
              <th style="width:110px">Šansa (težina)</th>
              <th style="width:120px">Zaliha</th>
              <th style="width:110px">Podeljeno</th>
              <th style="width:120px">Preostalo</th>
              <th style="width:110px">Rok (dana)</th>
              <th style="width:80px">Aktivna</th>
              <th style="width:230px"></th>
            </tr>
          </thead>
          <tbody>
            <% data.prizes.forEach(function(p) { %>
              <tr>
                <td>
                  <strong><%= p.label %></strong>
                  <% if (p.isFallback) { %><span class="badge bg-secondary ms-1">rezervna</span><% } %>
                </td>
                <td><input form="prize-<%= p.id %>" type="number" name="weight" min="0" step="any" value="<%= p.weight %>" class="form-control form-control-sm" required></td>
                <td><input form="prize-<%= p.id %>" type="number" name="stock" min="0" step="1" value="<%= p.stock == null ? '' : p.stock %>" placeholder="neograničeno" class="form-control form-control-sm"></td>
                <td><%= p.awardedCount %></td>
                <td><%= p.remaining == null ? "∞" : p.remaining %></td>
                <td><input form="prize-<%= p.id %>" type="number" name="validDays" min="1" max="365" step="1" value="<%= p.validDays %>" class="form-control form-control-sm" required></td>
                <td><input form="prize-<%= p.id %>" type="checkbox" name="isActive" value="true" class="form-check-input" <%= p.isActive ? "checked" : "" %> <%= p.isFallback ? "onclick=\"return false\"" : "" %>></td>
                <td class="text-nowrap">
                  <button form="prize-<%= p.id %>" type="submit" class="btn btn-sm btn-primary">Sačuvaj</button>
                  <a href="/admin/tocak/nagrade/<%= p.id %>/izmena" class="btn btn-sm btn-outline-secondary">Izmeni</a>
                  <% if (!p.isFallback && p.awardedCount === 0) { %>
                    <button form="prize-del-<%= p.id %>" type="submit" class="btn btn-sm btn-outline-danger" title="Briše nagradu sa točka"><i class="bi bi-trash"></i></button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% data.prizes.forEach(function(p) { %>
        <form action="/admin/tocak/nagrade/<%= p.id %>" method="POST" id="prize-<%= p.id %>" class="d-none">
          <input type="hidden" name="_method" value="PUT">
          <input type="hidden" name="CSRFToken" value="<%= data.csrfToken %>">
        </form>
        <% if (!p.isFallback && p.awardedCount === 0) { %>
          <form action="/admin/tocak/nagrade/<%= p.id %>" method="POST" id="prize-del-<%= p.id %>" class="d-none" data-confirm="Obrisati nagradu „<%= p.label %>“ sa točka?">
            <input type="hidden" name="_method" value="DELETE">
            <input type="hidden" name="CSRFToken" value="<%= data.csrfToken %>">
          </form>
        <% } %>
      <% }) %>
    </div>
    <div class="card-footer small text-muted">
      Šansa je relativna težina (45 : 25 : 15 znači da je prva tri puta verovatnija od treće). Kad zaliha nagrade dođe do nule,
      točak je više ne daje ni ne prikazuje, a umesto nje se dodeljuje sledeća. Prazna zaliha znači neograničeno. Zaliha ne može biti manja od već podeljenog.
      „Izmeni“ otvara punu formu (naziv, popust, usluge, boja). Nagrada koju je neko već osvojio ne može da se obriše, samo da se isključi; rezervna se ne briše dok ne označite drugu. Na točku mora biti 2 do 12 aktivnih nagrada.
    </div>
  </div>

  <div class="card">
    <div class="card-header fw-semibold">QR kod za štampu</div>
    <div class="card-body">
      <div class="row g-4 align-items-start">
        <div class="col-md-5 col-lg-4 text-center">
          <div class="border rounded-3 p-2 d-inline-block bg-white" style="width:260px;max-width:100%"><%- data.qrSvg %></div>
        </div>
        <div class="col-md-7 col-lg-8">
          <form method="GET" action="/admin/tocak/nagrade" class="row g-2 align-items-end mb-3">
            <div class="col-sm-8">
              <label class="form-label" for="qr-src">Oznaka događaja (izvor)</label>
              <input type="text" id="qr-src" name="src" value="<%= data.source %>" pattern="[A-Za-z0-9_\-]{1,60}" class="form-control" placeholder="npr. sajam-ns-2026">
            </div>
            <div class="col-sm-4"><button class="btn btn-outline-primary w-100" type="submit">Osveži QR</button></div>
          </form>
          <p class="mb-1 small text-muted">Kod vodi na:</p>
          <p class="mb-3"><a href="<%= data.url %>" target="_blank" rel="noopener"><code><%= data.url %></code></a></p>
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary btn-sm" href="/admin/tocak/qr.png?src=<%= encodeURIComponent(data.source) %>"><i class="bi bi-download"></i> PNG (1200 px)</a>
            <a class="btn btn-outline-primary btn-sm" href="/admin/tocak/qr.svg?src=<%= encodeURIComponent(data.source) %>"><i class="bi bi-download"></i> SVG (za štampu)</a>
          </div>
          <p class="small text-muted mt-3 mb-0">Za svaki događaj napravite poseban QR sa svojom oznakom, pa u listi kontakata možete filtrirati koliko ih je došlo sa kog sajma.</p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include("../../includes/footer") %>
