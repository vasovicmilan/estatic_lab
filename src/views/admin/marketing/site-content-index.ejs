<%
/**
 * /admin/sajt/sadrzaj - pregled svih uređivih tekstova sajta (SiteContent).
 * Svaka kartica vodi na /admin/sajt/sadrzaj/:section
 * (site-content.controller.js -> siteContentForm).
 */
%>
<%- include("../../includes/head") %>
<%- include("../../includes/navigation") %>

<main class="container-fluid py-4">
  <%- include("../../includes/breadcrumbs") %>
  <%- include("../../includes/flash-messages") %>

  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1"><%= pageTitle %></h1>
      <p class="text-muted mb-0">Izaberite tekst koji želite da izmenite. Izmene su odmah vidljive na javnom sajtu.</p>
    </div>
    <a href="<%= data.settingsUrl %>" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-gear"></i> Podešavanja sajta (hero slika, radno vreme...)
    </a>
  </div>

  <div class="row g-3">
    <% data.cards.forEach(function(card) { %>
      <div class="col-md-6 col-xl-4">
        <div class="card h-100">
          <div class="card-body d-flex flex-column">
            <h2 class="h6 mb-1"><i class="bi <%= card.icon %> me-2"></i><%= card.title %></h2>
            <p class="text-muted small mb-2"><%= card.description %></p>
            <% if (card.summary) { %>
              <p class="small mb-3"><span class="badge text-bg-light border"><%= card.summary %></span></p>
            <% } %>
            <div class="mt-auto d-flex gap-2">
              <a href="<%= card.editUrl %>" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Izmeni</a>
              <a href="<%= card.publicUrl %>" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Pogledaj na sajtu</a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</main>

<%- include("../../includes/footer") %>
