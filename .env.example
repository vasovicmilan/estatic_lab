# ============================================================================
# Estatic Lab - environment configuration
# ============================================================================
# Copy this file to .env and fill in real values. Never commit .env itself.
#
# NOTE on scope: as of the booking-policy/currency work, things that differ
# per BUSINESS (cancellation windows, currency, hero image) live in the admin
# panel (/admin/sajt) instead of here - see DEPLOYMENT.md. What's still in
# this file is either a genuine secret/credential, or something that differs
# per DEPLOYMENT (which database, which domain, which mailbox) rather than
# per business decision.

# ---- Core ----
NODE_ENV=production
PORT=3000

# Which modules this deployment has - comma-separated subset of blog,shop,booking.
# Every combination is valid (a single module alone, any pair, or all three).
# See docs/*/16-module-feature-flags.md. Defaults to all three if unset.
ENABLED_MODULES=blog,shop,booking
BASE_URL=https://example.com
SITE_NAME="Your Business Name"

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/estatic_lab
# Optional - connection pool size PER PROCESS. Leave unset for a normal single-instance
# deployment (Mongoose default). Set it when running PM2 in cluster mode against a
# connection-limited MongoDB tier (e.g. Atlas M0): every worker gets its own pool, so
# workers x pool size must stay under the tier's total connection limit.
# MONGO_MAX_POOL_SIZE=10

# ---- Secrets (generate fresh per deployment - never reuse across clients) ----
# openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# ---- Links placed in emails / Telegram alerts (see src/utils/link.builder.js) ----
# BASE_URL is the server-rendered website. FRONTEND_URL is the separate frontend that uses
# the JSON API (Angular etc.). An action started through /api/* gets links pointing at
# FRONTEND_URL (with that app's routes); an action started on the website gets BASE_URL links.
# Leave FRONTEND_URL unset if the frontend is served from the same origin as BASE_URL.
# Local Angular dev: FRONTEND_URL=http://localhost:4200
# FRONTEND_URL=
# Which face links point to when there is no request at all (cron reminders, scheduled
# campaigns): "web" (default) or "frontend". Switch to "frontend" when the separate
# frontend takes over the public domain.
# LINKS_DEFAULT_TARGET=web

# ---- CORS ----
# Comma-separated list of origins allowed to make cross-origin requests.
# Leave unset in most cases - only needed if something outside BASE_URL's own
# origin calls this API directly.
CORS_ORIGINS=

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="Your Business Name"
# How many times a failed outbound email is retried before being given up on.
EMAIL_MAX_SEND_ATTEMPTS=3

# ---- Contact addresses ----
# Where customer-facing "contact us" replies and support requests should land.
SUPPORT_EMAIL=
# Where internal admin notifications (new appointment, new order, etc.) are sent.
# Defaults to SUPPORT_EMAIL if unset.
ADMIN_EMAIL=

# ---- Google Calendar sync (per-employee calendar sync - see docs/11) ----
# Service account credentials, not a personal Google account.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# ---- Google OAuth (customer "sign in with Google") ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/google/callback
# Optional, comma-separated: extra Google OAuth client IDs allowed to sign
# tokens accepted by POST /api/v1/auth/google (see docs/*/15-api-v1-reference.md).
# Needed once a native app build (e.g. an Ionic/Capacitor client) gets its own
# Google Cloud Console client ID, distinct from GOOGLE_CLIENT_ID above.
GOOGLE_ADDITIONAL_CLIENT_IDS=

# ---- Telegram operational alerts (see docs/09, "Notifications") ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional per-category thread IDs, if the chat is a forum-mode supergroup with
# topics - leave unset to send everything to the main chat/thread.
TELEGRAM_APPOINTMENTS_THREAD=
TELEGRAM_ORDERS_THREAD=
TELEGRAM_PRODUCTS_THREAD=
TELEGRAM_CONTACTS_THREAD=
TELEGRAM_TESTIMONIALS_THREAD=
TELEGRAM_USERS_THREAD=
TELEGRAM_ERRORS_THREAD=

# ---- Cron / scheduled jobs ----
# IANA timezone the scheduler's cron expressions are evaluated in - should
# match the business's actual timezone, not the server's OS timezone.
CRON_TIMEZONE=Europe/Belgrade

# ---- Shop / orders ----
# Fallback flat shipping price (in the deployment's configured currency, see
# /admin/sajt) for non-freight orders, used only where a price isn't otherwise
# computed.
DEFAULT_SHIPPING_PRICE=350
# How long a guest has to confirm a pending order via the emailed link before
# it's no longer self-confirmable.
TEMP_ORDER_TOKEN_TTL_MINUTES=60
# How much longer after that the reservation is kept before the cleanup job
# releases the stock back - gives admin a window to manually confirm/follow up.
TEMP_ORDER_RETENTION_HOURS=24
# Referral commission grace period on shop orders (should match the business's
# actual statutory/policy return window).
ORDER_COMMISSION_GRACE_PERIOD_DAYS=14

# ---- Uploads ----
# Absolute path uploaded images/videos are written to. Leave unset to use the
# default (src/public) in a normal deployment - only needed to override for
# test harnesses or unusual hosting setups.
UPLOAD_PUBLIC_PATH=

# ---- Backups (see docs/*/17-backups.md) ----
# Absolute path on THIS server where daily backup folders (one per date,
# YYYY-MM-DD) are written. Required for scripts/backup.js - the script
# refuses to run without it, rather than guessing a default, since backups
# are exactly the kind of thing that should never silently land somewhere
# unexpected.
BACKUP_DIR=/var/backups/estatic-lab
# How many days of dated backup folders to keep before scripts/backup.js
# deletes the oldest ones automatically. Defaults to 14 if unset.
BACKUP_RETENTION_DAYS=14

# ---- Misc ----
# PM2 cluster instance index - PM2 sets this automatically, don't set by hand.
NODE_APP_INSTANCE=
# pino log level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
# Email address attributed as the author of blog posts created by the seed
# script - only relevant if you run the blog seed script.
POST_SEED_AUTHOR_EMAIL=
# AES-256-GCM key for src/services/crypto.service.js - used as raw UTF-8 bytes, so it
# must be EXACTLY 32 characters long (not 32 bytes of hex text like the secrets above).
# openssl rand -hex 16   (16 random bytes -> exactly 32 hex characters)
AES_SECRET=